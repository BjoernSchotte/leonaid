# This template is safe to commit. ./leonaid bootstrap replaces every token.
LEONAID_ENV=local
LEONAID_RESET_ALLOWED=true
# Chosen once by ./leonaid bootstrap from free host ports, then kept.
LEONAID_HTTP_PORT=__HOST_PORT__
LEONAID_HTTPS_PORT=__HOST_PORT__
# LAN access: set 0.0.0.0 and the host's LAN IP or name (dev stack becomes reachable).
LEONAID_BIND_ADDRESS=127.0.0.1
LEONAID_LAN_HOST=127.0.0.1
LEONAID_SECRET_KEY=__GENERATE_HEX_32__
LEONAID_ORDER_SUBMISSION_KEY=__GENERATE_HEX_32__
LEONAID_SESSION_ENCRYPTION_KEY=__GENERATE_URLSAFE_32__
CORE_POSTGRES_PASSWORD=__GENERATE_PASSWORD_24__
CMS_POSTGRES_PASSWORD=__GENERATE_PASSWORD_32__
CMS_S3_SECRET_ACCESS_KEY=__GENERATE_PASSWORD_32__
CMS_ENCRYPTION_KEY=emdash_enc_v1___GENERATE_URLSAFE_32__
TWENTY_POSTGRES_PASSWORD=__GENERATE_PASSWORD_24__
TWENTY_ACCESS_TOKEN_SECRET=__GENERATE_HEX_32__
TWENTY_LOGIN_TOKEN_SECRET=__GENERATE_HEX_32__
RUSTFS_ACCESS_KEY=__GENERATE_IDENTIFIER_20__
RUSTFS_SECRET_KEY=__GENERATE_PASSWORD_32__
LISTMONK_POSTGRES_PASSWORD=__GENERATE_PASSWORD_24__
TWENTY_BOOTSTRAP_EMAIL=__GENERATE_EMAIL__
TWENTY_BOOTSTRAP_PASSWORD=__GENERATE_PASSWORD_32__
