# This template is safe to commit. ./leonaid bootstrap replaces every token.
LEONAID_ENV=local
# The club shown in the admin rail. Production requires it; local and test
# fall back to "Lions Club Musterstadt" when it is empty.
LEONAID_CLUB_NAME=Lions Club Musterstadt
LEONAID_RESET_ALLOWED=true
# Chosen once by ./leonaid bootstrap from free host ports, then kept.
LEONAID_HTTP_PORT=__HOST_PORT__
LEONAID_HTTPS_PORT=__HOST_PORT__
# Set by ./leonaid bootstrap: "leonaid" only in the recorded main checkout,
# leonaid-wt-<checksum> in every other checkout. Plain `docker compose` calls
# with this file therefore address this checkout's own stack.
LEONAID_COMPOSE_PROJECT=__COMPOSE_PROJECT__
# LAN access: set 0.0.0.0 and the host's LAN name, e.g. myhost.local (not an IP:
# browsers send no TLS SNI for IPs). The dev stack then becomes reachable in the LAN.
# LEONAID_REMOTE_HOST is a second name for the same stack, e.g. the host's
# Tailscale/VPN name (myhost.tailnet.ts.net); keep 127.0.0.1 when unused.
LEONAID_BIND_ADDRESS=127.0.0.1
LEONAID_LAN_HOST=127.0.0.1
LEONAID_REMOTE_HOST=127.0.0.1
LEONAID_SECRET_KEY=__GENERATE_HEX_32__
LEONAID_ORDER_SUBMISSION_KEY=__GENERATE_HEX_32__
LEONAID_SESSION_ENCRYPTION_KEY=__GENERATE_URLSAFE_32__
# Web Push of the acquisition app (ADR-0017): the installation's P-256 key and
# the contact the push services read from every push. Without the key the app
# shows "not configured".
LEONAID_VAPID_PRIVATE_KEY=__GENERATE_P256_PRIVATE_KEY__
LEONAID_VAPID_SUBJECT=mailto:push@leonaid.invalid
CORE_POSTGRES_PASSWORD=__GENERATE_PASSWORD_24__
CMS_POSTGRES_PASSWORD=__GENERATE_PASSWORD_32__
CMS_S3_SECRET_ACCESS_KEY=__GENERATE_PASSWORD_32__
CMS_ENCRYPTION_KEY=emdash_enc_v1___GENERATE_URLSAFE_32__
TWENTY_POSTGRES_PASSWORD=__GENERATE_PASSWORD_24__
TWENTY_ACCESS_TOKEN_SECRET=__GENERATE_HEX_32__
TWENTY_LOGIN_TOKEN_SECRET=__GENERATE_HEX_32__
RUSTFS_ACCESS_KEY=__GENERATE_IDENTIFIER_20__
RUSTFS_SECRET_KEY=__GENERATE_PASSWORD_32__
LISTMONK_POSTGRES_PASSWORD=__GENERATE_PASSWORD_24__
TWENTY_BOOTSTRAP_EMAIL=__GENERATE_EMAIL__
TWENTY_BOOTSTRAP_PASSWORD=__GENERATE_PASSWORD_32__
# Modules switched off for this installation, comma-separated; unset keeps all on.
# LEONAID_DISABLED_MODULES=surveys
