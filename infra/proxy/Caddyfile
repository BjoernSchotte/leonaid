(common_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

(leonaid_routes) {
	handle /_health {
		respond "ready" 200
	}

	handle /api/health/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle_path /app/* {
		reverse_proxy pwa:3000
	}

	handle_path /admin/* {
		reverse_proxy web:3000
	}

	handle_path /crm/* {
		reverse_proxy twenty-server:3000
	}

	handle /mail/* {
		reverse_proxy mailpit:8025
	}

	handle_path /mailing/* {
		reverse_proxy listmonk:9000
	}

	handle {
		reverse_proxy public:3000
	}
}

http://crm.localhost:8080 {
	import common_headers
	reverse_proxy twenty-server:3000
}

http://:8080 {
	import common_headers
	import leonaid_routes
}

https://proxy:8443, https://localhost:8443 {
	tls internal
	import common_headers
	import leonaid_routes
}
