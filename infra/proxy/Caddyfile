(common_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

(leonaid_headers) {
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' ws: wss:; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src 'self' https://www.google.com https://maps.google.com; img-src 'self' data: blob:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
		X-Frame-Options DENY
	}
}

(leonaid_routes) {
	handle /_health {
		respond "ready" 200
	}

	handle /api/health/* {
		import leonaid_headers
		uri strip_prefix /api
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /api/* {
		import leonaid_headers
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle_path /app/* {
		import leonaid_headers
		reverse_proxy pwa:3000
	}

	handle_path /admin/* {
		import leonaid_headers
		reverse_proxy web:3000
	}

	handle_path /crm/* {
		reverse_proxy twenty-server:3000
	}

	handle /mail/* {
		reverse_proxy mailpit:8025
	}

	handle_path /mailing/* {
		reverse_proxy listmonk:9000
	}

	handle {
		import leonaid_headers
		reverse_proxy public:3000
	}
}

http://crm.localhost:8080 {
	import common_headers
	reverse_proxy twenty-server:3000
}

http://:8080 {
	import common_headers
	import leonaid_routes
}

https://proxy:8443, https://localhost:8443 {
	tls internal
	import common_headers
	import leonaid_routes
}
