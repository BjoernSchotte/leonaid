{
	email {$CADDY_ACME_EMAIL}
	admin off
	servers {
		strict_sni_host on
	}
}

(common_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

(leonaid_headers) {
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' wss:; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src 'self' https://www.google.com https://maps.google.com; img-src 'self' data: blob:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
		X-Frame-Options DENY
	}
}

# A host-specific HTTP route precedes Caddy's automatic HTTPS redirect.
http://{$LEONAID_PUBLIC_DOMAIN} {
	@internal_orders path /api/v1/public/actions/*/orders /api/v1/public/actions/*/orders/*
	handle @internal_orders {
		header Cache-Control no-store
		respond "Not Found" 404
	}
	handle /_health {
		respond "ready" 200
	}
	handle {
		redir https://{host}{uri} 308
	}
}

(order_declared_body_limit) {
	@oversized_order {
		method POST
		expression `(path('/_actions/createPublicOrder', '/_actions/createPublicOrder/') || query({'_action': 'createPublicOrder'})) && {http.request.header.Content-Length} != '' && int({http.request.header.Content-Length}) > 65536`
	}
	route @oversized_order {
		# Reject before a proxy request-body reader is started. Bound the HTTP/1
		# server's post-response drain as well as returning an immediate error.
		request_body {
			read_timeout 1s
		}
		header Cache-Control no-store
		respond "Das Bestellformular ist zu groß. Diese Anfrage wurde nicht an die Bestellverarbeitung weitergeleitet." 413 {
			close
		}
	}
}

:80 {
	handle /_health {
		respond "ready" 200
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

{$LEONAID_PUBLIC_DOMAIN} {
	import common_headers

	handle /_health {
		respond "ready" 200
	}

	handle /api/health/* {
		import leonaid_headers
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	handle /api/* {
		import leonaid_headers
		# Explicit order prevents the generic API proxy from exposing orders.
		route {
			@internal_orders path /api/v1/public/actions/*/orders /api/v1/public/actions/*/orders/*
			header @internal_orders Cache-Control no-store
			respond @internal_orders "Not Found" 404
			reverse_proxy api:8000
		}
	}

	@campaign_routes path /_emdash /_emdash/* /campaigns /campaigns/* /_campaign-assets/*
	handle @campaign_routes {
		import leonaid_headers
		import order_declared_body_limit
		reverse_proxy campaign-site:3000 {
			# Do not drain a stalled/rejected HTTP/1 body before returning its error.
			# This affects only CMS body-limit responses, not other applications.
			@body_rejected status 408 413
			handle_response @body_rejected {
				header Connection close
				copy_response
			}
			# common_headers supplies one unambiguous nosniff value at the edge.
			header_down -X-Content-Type-Options
			header_up -Forwarded
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {hostport}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle_path /app/* {
		import leonaid_headers
		reverse_proxy pwa:3000
	}

	handle_path /admin/* {
		import leonaid_headers
		reverse_proxy web:3000
	}

	handle {
		import leonaid_headers
		import order_declared_body_limit
		reverse_proxy public:3000 {
			@body_rejected status 408 413
			handle_response @body_rejected {
				header Connection close
				copy_response
			}
		}
	}
}

{$TWENTY_PUBLIC_DOMAIN} {
	import common_headers
	reverse_proxy twenty-server:3000
}
