# Safe template only. Copy it outside the repository, set mode 0600 and replace
# every placeholder before using infra/pilot/compose.yml.
# ./leonaid pilot-secrets --output FILE writes this template with fresh random
# values for every __RANDOM_*__ and __DISTINCT_RANDOM_*__ placeholder.
LEONAID_ENV=production
LEONAID_DEPLOYMENT_STAGE=production
LEONAID_COMPOSE_PROJECT=leonaid-production-__TENANT_ID__
LEONAID_BIND_ADDRESS=0.0.0.0
# The next nine lines come from release-images.env of the GitHub release
# (./leonaid release). Copy them unchanged; images carry tag and digest.
LEONAID_SERVICE_VERSION=__CALVER_VERSION__
LEONAID_RELEASE_COMMIT=__FULL_GIT_SHA__
LEONAID_CORE_IMAGE=ghcr.io/bjoernschotte/leonaid/core:__CALVER_VERSION__@sha256:__DIGEST__
LEONAID_WEB_IMAGE=ghcr.io/bjoernschotte/leonaid/web:__CALVER_VERSION__@sha256:__DIGEST__
LEONAID_PWA_IMAGE=ghcr.io/bjoernschotte/leonaid/pwa:__CALVER_VERSION__@sha256:__DIGEST__
LEONAID_PUBLIC_IMAGE=ghcr.io/bjoernschotte/leonaid/public:__CALVER_VERSION__@sha256:__DIGEST__
LEONAID_PROXY_IMAGE=ghcr.io/bjoernschotte/leonaid/proxy:__CALVER_VERSION__@sha256:__DIGEST__
LEONAID_SURVEY_VALIDATOR_IMAGE=ghcr.io/bjoernschotte/leonaid/survey-validator:__CALVER_VERSION__@sha256:__DIGEST__
LEONAID_CAMPAIGN_SITE_IMAGE=ghcr.io/bjoernschotte/leonaid/campaign-site:__CALVER_VERSION__@sha256:__DIGEST__

# The club this installation serves, shown in the admin rail (required).
LEONAID_CLUB_NAME=__CLUB_NAME__
# Hosts (specs/multi-domain; help docs: "Install LeonAid on a fresh VPS",
# sections "Point DNS to the server" and "Generate the production secrets";
# an existing installation: "Switch to an admin host"). One host: only
# LEONAID_PUBLIC_DOMAIN, the base URL and the origin below, and the four
# admin/public host lines stay commented out.
LEONAID_PUBLIC_DOMAIN=portal.example.org
LEONAID_PUBLIC_BASE_URL=https://portal.example.org
LEONAID_ALLOWED_ORIGINS=https://portal.example.org
# Admin host plus public host: members and editors move to app.<domain>;
# the old host stays the public host, so every printed link keeps working.
# Then LEONAID_PUBLIC_BASE_URL and LEONAID_ALLOWED_ORIGINS name the admin
# host (https://app.example.org) and these lines are set:
# LEONAID_ADMIN_DOMAIN=app.example.org
# LEONAID_PROXY_CADDYFILE=Caddyfile.split
# LEONAID_SITE_BASE_URL=https://example.org
# LEONAID_PUBLIC_ORIGINS=https://example.org
# Optional further names of the public host; each redirects to it. Separate
# several names with ", " (comma and space).
# LEONAID_PUBLIC_DOMAIN_ALIASES=www.example.org
# The CRM UI has no public domain. twenty-server listens on 127.0.0.1 of the
# host only, on this port; ./leonaid crm-admin prints the SSH tunnel to it.
TWENTY_ADMIN_PORT=3020
CADDY_ACME_EMAIL=operations@example.org

LEONAID_SECRET_KEY=__RANDOM_HEX_32_BYTES__
LEONAID_ORDER_SUBMISSION_KEY=__DISTINCT_RANDOM_HEX_32_BYTES__
LEONAID_SESSION_ENCRYPTION_KEY=__DISTINCT_RANDOM_URLSAFE_32_BYTES__
CORE_POSTGRES_PASSWORD=__RANDOM_PASSWORD__
TWENTY_POSTGRES_PASSWORD=__RANDOM_PASSWORD__
TWENTY_ACCESS_TOKEN_SECRET=__RANDOM_HEX_32_BYTES__
TWENTY_LOGIN_TOKEN_SECRET=__DISTINCT_RANDOM_HEX_32_BYTES__
# Campaign pages and the EmDash editor (help docs: "Install LeonAid on a
# fresh VPS", "Generate the production secrets"; KNOWN-LIMITS). Set
# LEONAID_CMS_ENABLED=true only after the CMS database and media bucket are
# provisioned; until then the stack runs without the campaign-site service.
LEONAID_CMS_ENABLED=false
CMS_POSTGRES_PASSWORD=__RANDOM_PASSWORD__
CMS_S3_SECRET_ACCESS_KEY=__RANDOM_SECRET_KEY__
CMS_ENCRYPTION_KEY=__RANDOM_EMDASH_KEY__
RUSTFS_ACCESS_KEY=__RANDOM_ACCESS_KEY__
RUSTFS_SECRET_KEY=__RANDOM_SECRET_KEY__
RUSTFS_BUCKET=leonaid-production-__TENANT_ID__
RESTIC_REPOSITORY=s3:https://__BACKUP_ENDPOINT__/leonaid-production-__TENANT_ID__
LEONAID_BACKUP_MANIFEST_PATH=/var/lib/leonaid/evidence/latest-backup-manifest.json
LEONAID_MONITORED_DISK_PATH=/var/lib/leonaid
LEONAID_ALERT_WEBHOOK_URL_FILE=/etc/leonaid/secrets/alert-webhook-url
# External dead man's switch (for example a healthchecks.io ping URL). It must
# differ from the operator webhook and must not run on this host.
LEONAID_ALERT_HEARTBEAT_URL_FILE=/etc/leonaid/secrets/alert-heartbeat-url

MAIL_HEALTH_URL=https://status.example.org/mail
# One SMTP relay serves the core worker and Twenty CRM (password reset,
# address verification). tls means implicit TLS and needs port 465; starttls
# needs a port other than 465 (usually 587). The relay needs a certificate
# from a public CA. plain is refused in production.
# Twenty sends mail only with tls: its SMTP client cannot insist on STARTTLS.
# With starttls the core worker still sends, Twenty sends nothing and
# pilot-doctor warns.
MAIL_SMTP_HOST=smtp.example.org
MAIL_SMTP_PORT=465
MAIL_FROM=LeonAid <noreply@example.org>
MAIL_ENVELOPE_FROM=bounces@example.org
MAIL_REPLY_TO=support@example.org
MAIL_SMTP_MODE=tls
MAIL_SMTP_USERNAME=__SMTP_USERNAME__
MAIL_SMTP_PASSWORD=__SMTP_PASSWORD__
MAIL_SMTP_TIMEOUT_SECONDS=10
# Modules switched off for this club, comma-separated. Their data stays;
# unset keeps every module on.
# LEONAID_DISABLED_MODULES=surveys
# Sender of Twenty's own mail. The address must use the domain of MAIL_FROM,
# whose SPF, DKIM and DMARC records the relay already satisfies.
TWENTY_MAIL_FROM_ADDRESS=crm@example.org
TWENTY_MAIL_FROM_NAME=LeonAid CRM

# Keep PENDING_PILOT_INSTALL for a first install: ./leonaid pilot-install
# provisions the least-privilege key in Twenty and writes it here.
TWENTY_INTEGRATION_API_KEY=PENDING_PILOT_INSTALL

# Campaign domains (specs/multi-domain §7.4): a domain passes the check only
# when every A/AAAA record names one of this server's public addresses. By
# default these are the addresses of the admin host (or the one host); set
# them here when that host sits behind another address.
# LEONAID_SITE_HOST_EDGE_ADDRESSES=203.0.113.10, 2001:db8::10
