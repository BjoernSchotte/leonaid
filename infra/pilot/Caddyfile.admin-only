			header_up X-Forwarded-Proto {scheme}
		}
	}

	@slashless_service_roots path /app /admin
	handle @slashless_service_roots {
		redir https://{$LEONAID_ADMIN_DOMAIN}{uri} 308
	}

	@member_routes path /app/* /admin/* /login /login/* /invite /email-change /fresh-login
	handle @member_routes {
		redir https://{$LEONAID_ADMIN_DOMAIN}{uri} 308
	}

	@admin_public_pages path /impressum /datenschutz /_astro/* /favicon.ico /favicon.svg /community-routes.png /community-routes.webp
	handle @admin_public_pages {
		import astro_headers
		import astro_asset_encoding
		import order_declared_body_limit
		reverse_proxy public:3000 {
			@body_rejected status 408 413
			handle_response @body_rejected {
				header Connection close
				copy_response
			}
		}
	}

	@public_order path /_actions/createPublicOrder /_actions/createPublicOrder/
	handle @public_order {
		import astro_headers
		import astro_asset_encoding
		import order_declared_body_limit
		reverse_proxy public:3000 {
			@body_rejected status 408 413
			handle_response @body_rejected {
				header Connection close
				copy_response
			}
		}
	}

	handle {
		import astro_headers
		import astro_asset_encoding
		import order_declared_body_limit
		reverse_proxy campaign-site:3000 {
			# Do not drain a stalled/rejected HTTP/1 body before returning its error.
			# This affects only CMS body-limit responses, not other applications.
			@body_rejected status 408 413
			handle_response @body_rejected {
				header Connection close
				copy_response
			}
			# common_headers supplies one unambiguous nosniff value at the edge.
			header_down -X-Content-Type-Options
			header_up -Forwarded
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {hostport}
			header_up X-Forwarded-Proto {scheme}
