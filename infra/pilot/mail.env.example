# Public/non-secret API health target. Inject only into the API service.
MAIL_HEALTH_URL=https://status.selected-relay.invalid/health

# Worker-only SMTP transport. Replace placeholders through the private
# deployment secret store; never commit a populated copy.
MAIL_SMTP_HOST=smtp.selected-relay.invalid
MAIL_SMTP_PORT=587
MAIL_FROM=LeonAid <noreply@club-domain.invalid>
MAIL_ENVELOPE_FROM=bounces@club-domain.invalid
MAIL_REPLY_TO=support@club-domain.invalid
MAIL_SMTP_MODE=starttls
MAIL_SMTP_USERNAME=SET_VIA_PRIVATE_SECRET_STORE
MAIL_SMTP_PASSWORD=SET_VIA_PRIVATE_SECRET_STORE
MAIL_SMTP_TIMEOUT_SECONDS=10
MAIL_SMTP_VERIFY_CERTIFICATES=true
MAIL_SMTP_CA_FILE=
