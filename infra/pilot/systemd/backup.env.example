# Paths for leonaid-backup.service. Copy to /etc/leonaid/backup.env, owner
# leonaid, mode 0600. The file holds paths only, no secrets.
LEONAID_CHECKOUT=/opt/leonaid
LEONAID_ENV_FILE=/etc/leonaid/production.env
LEONAID_BACKUP_MANIFEST=/var/lib/leonaid/evidence/latest-backup-manifest.json
LEONAID_RESTIC_PASSWORD_FILE=/etc/leonaid/secrets/restic-password
LEONAID_BACKUP_CREDENTIALS_FILE=/etc/leonaid/secrets/restic-backend.env
