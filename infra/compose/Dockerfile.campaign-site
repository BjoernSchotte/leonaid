FROM docker.io/library/python:3.13.18-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc AS release-identity
WORKDIR /identity
COPY bun.lock ./
COPY apps/campaign-site ./apps/campaign-site
COPY apps/public/runtime-allowed-domains.mjs ./apps/public/
COPY tools/pilot_release/cms_identity.py tools/pilot_release/cms_image_identity.py ./tools/pilot_release/
COPY tools/emdash_spike/krapfentaxi-import.mjs ./tools/emdash_spike/
COPY tools/backup/cms-recovery.mjs ./tools/backup/
COPY infra/compose/Dockerfile.campaign-site ./infra/compose/
RUN python tools/pilot_release/cms_image_identity.py build --root /identity --output /identity/cms-release-identity.json

FROM docker.io/oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS dependencies
WORKDIR /workspace
COPY package.json bun.lock ./
COPY apps/campaign-site/package.json ./apps/campaign-site/package.json
COPY apps/docs/package.json ./apps/docs/package.json
COPY apps/public/package.json ./apps/public/package.json
COPY apps/pwa/package.json ./apps/pwa/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json
COPY packages/features/package.json ./packages/features/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/surveys/package.json ./packages/surveys/package.json
RUN bun install --frozen-lockfile --ignore-scripts

FROM docker.io/library/node:22.23.4-alpine3.24@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202 AS build
WORKDIR /workspace
ENV ASTRO_TELEMETRY_DISABLED=1
COPY --from=dependencies /workspace ./
COPY apps/campaign-site ./apps/campaign-site
COPY apps/public ./apps/public
COPY packages/api-client ./packages/api-client
# The shared public layout imports the Leitsystem tokens and fonts (CSS only).
COPY packages/ui ./packages/ui
WORKDIR /workspace/apps/campaign-site
RUN node /workspace/node_modules/astro/bin/astro.mjs check
RUN node /workspace/node_modules/astro/bin/astro.mjs build

FROM docker.io/oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS runtime-dependencies
WORKDIR /workspace
COPY --from=dependencies /workspace ./
RUN bun install --frozen-lockfile --production --ignore-scripts

FROM docker.io/library/node:22.23.4-alpine3.24@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202
WORKDIR /app
COPY --from=release-identity /identity/cms-release-identity.json ./cms-release-identity.json
COPY --from=runtime-dependencies /workspace/node_modules ./node_modules
COPY --from=build /workspace/apps/campaign-site/dist ./dist
# Image-owned operators: schema migration (cms-migration-operator) and the
# production provisioning of ./leonaid pilot-cms-provision (cms-provision-operator).
COPY --from=build /workspace/apps/campaign-site/src/cms-maintenance.mjs /workspace/apps/campaign-site/src/cms-migration-operator.mjs /workspace/apps/campaign-site/src/campaign-schema.mjs /workspace/apps/campaign-site/src/install-campaign-schema.mjs /workspace/apps/campaign-site/src/bootstrap-control.mjs /workspace/apps/campaign-site/src/cms-provision-operator.mjs /workspace/apps/campaign-site/src/cms-provision-state.mjs /workspace/apps/campaign-site/src/provision-postgres.mjs ./operator/
COPY --from=build /workspace/apps/campaign-site/src/auth/campaign-bindings.mjs /workspace/apps/campaign-site/src/auth/campaign-media.mjs /workspace/apps/campaign-site/src/auth/identity-map.mjs ./operator/auth/
# The restore operator (tools/backup/cms-recovery.mjs) in its repository
# layout, so a production host restores the CMS without node_modules in the
# checkout (pilot-restore passes this image as LEONAID_RESTORE_CMS_IMAGE).
COPY --from=release-identity /identity/tools/backup/cms-recovery.mjs ./recovery/tools/backup/
COPY --from=build /workspace/apps/campaign-site/src/provision-postgres.mjs /workspace/apps/campaign-site/src/install-campaign-schema.mjs /workspace/apps/campaign-site/src/campaign-schema.mjs ./recovery/apps/campaign-site/src/
COPY --from=build /workspace/apps/campaign-site/src/auth/campaign-bindings.mjs /workspace/apps/campaign-site/src/auth/campaign-media.mjs ./recovery/apps/campaign-site/src/auth/
# sharp/libvips size their worker pool from the host's CPU count, not the
# container's CPU quota (32 threads per image pipeline on a 32-core host). With
# the service's pids_limit, concurrent image transforms then fail to create
# threads ("glib: Error creating thread"), Astro serves the image unoptimized,
# and libvips can crash Node with SIGSEGV in vips_sink_disc. The service is
# limited to one CPU, so one libvips worker per pipeline loses nothing.
ENV VIPS_CONCURRENCY=1
ENV HOST=0.0.0.0
ENV PORT=3000
ENV NODE_ENV=production
# The server runs node only; drop the package managers the base image bundles.
RUN rm -rf /opt/yarn-v* /usr/local/lib/node_modules/corepack /usr/local/lib/node_modules/npm \
  && mkdir /app/bootstrap-state && chown node:node /app/bootstrap-state
USER node
EXPOSE 3000
CMD ["node", "./dist/server/entry.mjs"]
