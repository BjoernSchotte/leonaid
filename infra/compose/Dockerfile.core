FROM ghcr.io/typst/typst:v0.13.1@sha256:253fa1351e43316f5f8dd12d0dd7906b7eedc0c986bff9a374be749032da00c0 AS typst

FROM ghcr.io/astral-sh/uv:0.13.6-python3.13-trixie-slim@sha256:e586c1c65b7071aec78f02c5587c76c5011159cd76b3d6f1255f40e48e850abc

# Security updates the pinned base image does not have yet: perl-base,
# apt/libapt-pkg7.0 3.0.4 (CVE-2026-109518) and zlib1g 1.3.1-1+deb13u1
# (CVE-2026-76844, CVE-2026-85091). zlib1g is pinned to the exact security
# revision, so a superseded revision fails the build instead of drifting.
# Drop each one once the base image digest ships it.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends --only-upgrade \
      perl-base apt libapt-pkg7.0 \
      zlib1g=1:1.3.dfsg+really1.3.1-1+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

# Fixed, unprivileged runtime identity. The uid/gid are part of the operations
# contract: the core-volume-init service in compose.yml hands volumes written by
# older root-running releases over to exactly this uid.
RUN groupadd --system --gid 10001 leonaid \
    && useradd --system --uid 10001 --gid 10001 --home-dir /home/leonaid \
      --create-home --shell /usr/sbin/nologin leonaid \
    && install -d -o 10001 -g 10001 -m 0750 /recovery/survey-erasure

WORKDIR /workspace
ENV PATH="/workspace/.venv/bin:${PATH}" \
    PYTHONPATH="/workspace/src" \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=typst /bin/typst /usr/local/bin/typst

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project \
    && rm -rf /root/.cache/uv

# The application lives in /workspace/.venv and is managed by uv. The base
# image's system pip (and its bundled wheel) vendors outdated msgpack, urllib3
# and pkg_resources and is never used at runtime, so it is removed.
RUN rm -rf /usr/local/lib/python3.13/site-packages/pip \
      /usr/local/lib/python3.13/site-packages/pip-*.dist-info \
      /usr/local/lib/python3.13/ensurepip/_bundled \
      /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.13

COPY src ./src
COPY apps ./apps
COPY alembic.ini ./
COPY migrations ./migrations
COPY infra/compose/start-api.sh ./infra/compose/start-api.sh

# Runtime uv calls (e.g. `uv run alembic` during pilot-release) must not need a
# writable home: the root filesystem is read-only and only /tmp is a tmpfs.
ENV UV_CACHE_DIR=/tmp/uv-cache
USER 10001:10001
