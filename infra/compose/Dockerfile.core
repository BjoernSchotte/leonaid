FROM ghcr.io/typst/typst:v0.13.1@sha256:253fa1351e43316f5f8dd12d0dd7906b7eedc0c986bff9a374be749032da00c0 AS typst

FROM ghcr.io/astral-sh/uv:0.11.17-python3.13-trixie-slim@sha256:6181d17d152967488408b4ced7b2930cc91c2b39adb7af6fb339965afce3404e

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends --only-upgrade perl-base \
    && rm -rf /var/lib/apt/lists/*

# Fixed, unprivileged runtime identity. The uid/gid are part of the operations
# contract: the core-volume-init service in compose.yml hands volumes written by
# older root-running releases over to exactly this uid.
RUN groupadd --system --gid 10001 leonaid \
    && useradd --system --uid 10001 --gid 10001 --home-dir /home/leonaid \
      --create-home --shell /usr/sbin/nologin leonaid \
    && install -d -o 10001 -g 10001 -m 0750 /recovery/survey-erasure

WORKDIR /workspace
ENV PATH="/workspace/.venv/bin:${PATH}" \
    PYTHONPATH="/workspace/src" \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=typst /bin/typst /usr/local/bin/typst

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project \
    && rm -rf /root/.cache/uv

COPY src ./src
COPY apps ./apps
COPY alembic.ini ./
COPY migrations ./migrations
COPY infra/compose/start-api.sh ./infra/compose/start-api.sh

# Runtime uv calls (e.g. `uv run alembic` during pilot-release) must not need a
# writable home: the root filesystem is read-only and only /tmp is a tmpfs.
ENV UV_CACHE_DIR=/tmp/uv-cache
USER 10001:10001
