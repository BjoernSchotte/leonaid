FROM docker.io/oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS build
WORKDIR /workspace
COPY package.json bun.lock ./
COPY apps/campaign-site/package.json ./apps/campaign-site/package.json
COPY apps/docs/package.json ./apps/docs/package.json
COPY apps/public/package.json ./apps/public/package.json
COPY apps/pwa/package.json ./apps/pwa/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json
COPY packages/features/package.json ./packages/features/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/surveys/package.json ./packages/surveys/package.json
RUN bun install --frozen-lockfile --ignore-scripts
COPY packages/surveys ./packages/surveys
COPY infra/compose/survey-validator.mjs ./infra/compose/survey-validator.mjs
RUN bun build infra/compose/survey-validator.mjs --target=bun --outfile=/validator.mjs

FROM docker.io/oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a
WORKDIR /app
COPY --from=build /validator.mjs ./validator.mjs
COPY infra/compose/survey-validator-NOTICES.txt ./THIRD-PARTY-NOTICES.txt
USER bun
CMD ["bun", "validator.mjs"]
