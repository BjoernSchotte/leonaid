FROM docker.io/oven/bun:1.2.19-alpine@sha256:7dc0e33a62cbc1606d14b07706c3a00ae66e8e9d0e81b83241ed609763e66d55 AS build
WORKDIR /workspace
COPY package.json bun.lock ./
COPY apps/public/package.json ./apps/public/package.json
COPY apps/pwa/package.json ./apps/pwa/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json
COPY packages/features/package.json ./packages/features/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/surveys/package.json ./packages/surveys/package.json
RUN bun install --frozen-lockfile --ignore-scripts
COPY packages/surveys ./packages/surveys
COPY infra/compose/survey-validator.mjs ./infra/compose/survey-validator.mjs
RUN bun build infra/compose/survey-validator.mjs --target=bun --outfile=/validator.mjs

FROM docker.io/oven/bun:1.2.19-alpine@sha256:7dc0e33a62cbc1606d14b07706c3a00ae66e8e9d0e81b83241ed609763e66d55
WORKDIR /app
COPY --from=build /validator.mjs ./validator.mjs
COPY infra/compose/survey-validator-NOTICES.txt ./THIRD-PARTY-NOTICES.txt
USER bun
CMD ["bun", "validator.mjs"]
