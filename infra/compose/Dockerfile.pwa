FROM docker.io/oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS build

WORKDIR /workspace
COPY package.json bun.lock ./
COPY apps/campaign-site/package.json ./apps/campaign-site/package.json
COPY apps/docs/package.json ./apps/docs/package.json
COPY apps/public/package.json ./apps/public/package.json
COPY apps/pwa/package.json ./apps/pwa/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json
COPY packages/features/package.json ./packages/features/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/surveys/package.json ./packages/surveys/package.json
RUN bun install --frozen-lockfile --ignore-scripts
COPY apps/pwa ./apps/pwa
COPY packages/api-client ./packages/api-client
COPY packages/surveys ./packages/surveys
COPY packages/features ./packages/features
COPY packages/ui ./packages/ui
RUN bun run build:pwa

FROM docker.io/library/node:22.23.4-alpine3.24@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914

WORKDIR /app
RUN rm -rf /opt/yarn-v1.22.22 /usr/local/lib/node_modules/corepack /usr/local/lib/node_modules/npm
COPY infra/compose/static-server.mjs ./static-server.mjs
COPY --from=build /workspace/apps/pwa/dist ./pwa-dist
ENV PWA_ASSET_DIR=/app/pwa-dist
USER node
EXPOSE 3000
CMD ["node", "static-server.mjs"]
