{
  "name": "@leonaid/root",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.2.19",
  "engines": {
    "bun": "1.2.19",
    "node": "22.17.1"
  },
  "scripts": {
    "build:public": "bun run --filter @leonaid/public build",
    "build:web": "bun run --filter @leonaid/web build",
    "build:pwa": "bun run --filter @leonaid/pwa build",
    "check:locks": "bun install --frozen-lockfile --ignore-scripts",
    "test:components": "bun run --filter @leonaid/web test:components",
    "typecheck": "bun run typecheck:api-client && bun run typecheck:ui && bun run typecheck:features && bun run typecheck:web && bun run typecheck:pwa && bun run typecheck:public",
    "typecheck:api-client": "tsc --noEmit -p packages/api-client/tsconfig.json",
    "typecheck:features": "tsc --noEmit -p packages/features/tsconfig.json",
    "typecheck:pwa": "tsc --noEmit -p apps/pwa/tsconfig.json",
    "typecheck:public": "bun run --filter @leonaid/public typecheck",
    "typecheck:ui": "tsc --noEmit -p packages/ui/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.54.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "29.1.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
