{
  "components": {
    "schemas": {
      "ApiErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "examples": [
              "endpoint_not_found"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "examples": [
              "Dieser API-Endpunkt existiert nicht."
            ],
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "examples": [
              "poc023:contract:golden-v1"
            ],
            "maxLength": 128,
            "minLength": 8,
            "title": "Requestid",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "title": "ApiErrorDetail",
        "type": "object"
      },
      "ApiErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ApiErrorResponse",
        "type": "object"
      },
      "CurrentIdentityResponse": {
        "additionalProperties": false,
        "properties": {
          "actionMemberships": {
            "items": {
              "$ref": "#/components/schemas/IdentityMembershipResponse"
            },
            "title": "Actionmemberships",
            "type": "array"
          },
          "displayName": {
            "title": "Displayname",
            "type": "string"
          },
          "globalRoles": {
            "items": {
              "enum": [
                "system_admin",
                "finance_reader",
                "finance_manager"
              ],
              "type": "string"
            },
            "title": "Globalroles",
            "type": "array"
          },
          "navigation": {
            "items": {
              "$ref": "#/components/schemas/NavigationItemResponse"
            },
            "title": "Navigation",
            "type": "array"
          },
          "roleLabels": {
            "items": {
              "type": "string"
            },
            "title": "Rolelabels",
            "type": "array"
          },
          "userId": {
            "format": "uuid",
            "title": "Userid",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "displayName",
          "globalRoles",
          "actionMemberships",
          "roleLabels",
          "navigation"
        ],
        "title": "CurrentIdentityResponse",
        "type": "object"
      },
      "DependencyStatusResponse": {
        "additionalProperties": false,
        "properties": {
          "details": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "title": "Details",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not-ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "details"
        ],
        "title": "DependencyStatusResponse",
        "type": "object"
      },
      "IdentityMembershipResponse": {
        "additionalProperties": false,
        "properties": {
          "actionId": {
            "format": "uuid",
            "title": "Actionid",
            "type": "string"
          },
          "actionName": {
            "title": "Actionname",
            "type": "string"
          },
          "role": {
            "enum": [
              "charity_admin",
              "acquirer",
              "finance_reader",
              "driver"
            ],
            "title": "Role",
            "type": "string"
          },
          "roleLabel": {
            "title": "Rolelabel",
            "type": "string"
          }
        },
        "required": [
          "actionId",
          "actionName",
          "role",
          "roleLabel"
        ],
        "title": "IdentityMembershipResponse",
        "type": "object"
      },
      "NavigationItemResponse": {
        "additionalProperties": false,
        "properties": {
          "href": {
            "title": "Href",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "surface": {
            "enum": [
              "web",
              "pwa"
            ],
            "title": "Surface",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "href",
          "surface"
        ],
        "title": "NavigationItemResponse",
        "type": "object"
      },
      "PlatformInformationResponse": {
        "additionalProperties": false,
        "properties": {
          "apiVersion": {
            "examples": [
              "v1"
            ],
            "title": "Apiversion",
            "type": "string"
          },
          "release": {
            "examples": [
              "0.0.0"
            ],
            "title": "Release",
            "type": "string"
          },
          "service": {
            "examples": [
              "leonaid-api"
            ],
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service",
          "release",
          "apiVersion"
        ],
        "title": "PlatformInformationResponse",
        "type": "object"
      },
      "PlatformStatusResponse": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "examples": [
              "leonaid-api"
            ],
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "live",
            "examples": [
              "live"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service",
          "status"
        ],
        "title": "PlatformStatusResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatusResponse"
            },
            "title": "Checks",
            "type": "object"
          },
          "service": {
            "examples": [
              "leonaid-api"
            ],
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "not-ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service",
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "LeonAid Core",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/identity/me": {
      "get": {
        "operationId": "getCurrentIdentity",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentIdentityResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Keine gültige serverseitige Sitzung."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Die angemeldete Persona besitzt nicht die nötigen Rechte."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Endpunkt oder Fachobjekt wurde nicht gefunden."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Transport- oder Fachvalidierung ist fehlgeschlagen."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unerwarteter interner Fehler."
          }
        },
        "summary": "Current Identity",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/platform": {
      "get": {
        "operationId": "getPlatformInformation",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformInformationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Endpunkt oder Fachobjekt wurde nicht gefunden."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Transport- oder Fachvalidierung ist fehlgeschlagen."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unerwarteter interner Fehler."
          }
        },
        "summary": "Information",
        "tags": [
          "platform"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "getHealthLive",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Endpunkt oder Fachobjekt wurde nicht gefunden."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Transport- oder Fachvalidierung ist fehlgeschlagen."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unerwarteter interner Fehler."
          }
        },
        "summary": "Live",
        "tags": [
          "platform"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getHealthReady",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Endpunkt oder Fachobjekt wurde nicht gefunden."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Transport- oder Fachvalidierung ist fehlgeschlagen."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unerwarteter interner Fehler."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "platform"
        ]
      }
    }
  }
}
