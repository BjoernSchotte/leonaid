{
  "components": {
    "schemas": {
      "AcceptInvitationRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "anyOf": [
              {
                "pattern": "^[0-9]{6}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "email": {
            "anyOf": [
              {
                "maxLength": 320,
                "minLength": 3,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "magicToken": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Magictoken"
          }
        },
        "title": "AcceptInvitationRequest",
        "type": "object"
      },
      "ApiErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "examples": [
              "endpoint_not_found"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "examples": [
              "Dieser API-Endpunkt existiert nicht."
            ],
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "examples": [
              "poc023:contract:golden-v1"
            ],
            "maxLength": 128,
            "minLength": 8,
            "title": "Requestid",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "title": "ApiErrorDetail",
        "type": "object"
      },
      "ApiErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ApiErrorResponse",
        "type": "object"
      },
      "CreateInvitationRequest": {
