pilot_deploy() {
  require_docker
  env_file=
  backup_manifest=
  release_manifest=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --env-file)
        [ "$#" -ge 2 ] || {
          echo "pilot-deploy: ERROR: --env-file benötigt einen Pfad" >&2
          exit 64
        }
        env_file=$2
        shift 2
        ;;
      --backup-manifest)
        [ "$#" -ge 2 ] || {
          echo "pilot-deploy: ERROR: --backup-manifest benötigt einen Pfad" >&2
          exit 64
        }
        backup_manifest=$2
        shift 2
        ;;
      --release-manifest)
        [ "$#" -ge 2 ] || {
          echo "pilot-deploy: ERROR: --release-manifest benötigt einen Pfad" >&2
          exit 64
        }
        release_manifest=$2
        shift 2
        ;;
      *)
        echo "pilot-deploy: ERROR: unbekannte Option '$1'" >&2
        exit 64
        ;;
    esac
  done
  [ -n "$env_file" ] || {
    echo "pilot-deploy: ERROR: --env-file fehlt" >&2
    exit 64
  }
  [ -n "$backup_manifest" ] || {
    echo "pilot-deploy: ERROR: --backup-manifest fehlt" >&2
    exit 64
  }
  [ -n "$release_manifest" ] || {
    echo "pilot-deploy: ERROR: --release-manifest fehlt" >&2
    exit 64
  }
  env_file=$(pilot_absolute_file pilot-deploy "$env_file")
  backup_manifest=$(pilot_absolute_file pilot-deploy "$backup_manifest")
  release_manifest=$(pilot_absolute_file pilot-deploy "$release_manifest")
  project=$(pilot_environment_value LEONAID_COMPOSE_PROJECT "$env_file")
  case "$project" in
    leonaid-production*|leonaid-staging*) ;;
    *)
      echo "pilot-deploy: BLOCKED: Compose-Projekt ist nicht umgebungsspezifisch" >&2
      exit 1
      ;;
  esac
  release_commit=$(git -C "$root" rev-parse HEAD)
  config_file=$(mktemp)
  trap 'rm -f "$config_file"' EXIT HUP INT TERM
  pilot_compose_config "$project" "$env_file" "$config_file"
  pilot_verify_release_manifest \
    "$release_manifest" "$config_file" "$release_commit"
  pilot_decision_gate "$project" pilot-deploy
  pilot_compose_up "$project" "$env_file"
  pilot_doctor \
    --env-file "$env_file" \
    --backup-manifest "$backup_manifest" \
    --gate pilot-deploy
  rm -f "$config_file"
  trap - EXIT HUP INT TERM
  echo "pilot-deploy: OK: $project läuft exakt aus dem verifizierten Release-Manifest"
}

