#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$root/infra/locks/images.env"

usage() {
  cat <<'EOF'
LeonAid PoC

Usage: ./leonaid <command>

Commands:
  bootstrap         Create local secrets and install locked packages in Docker
  doctor            Diagnose Docker, locks, secrets and local dependencies
  dev               Build and start the ready PoC core stack
  check             Run non-mutating quality and policy gates
  generate-api-client
                    Regenerate canonical OpenAPI and TypeScript client
  provision-twenty  Provision and verify Twenty schema, roles and API key
  import-crm <dry-run|apply> SOURCE [OPTIONS]
                    Analyze or import an XLSX/CSV file through the Twenty API
  test-twenty-gateway
                    Run the real Twenty CRM gateway contract
  test-crm-import   Prove the Golden XLSX import against an empty real Twenty
  test-identity     Prove accounts, roles, sessions and persona navigation
  test-invitations  Prove invitation permissions, link/code and real delivery
  test-sessions     Prove 90-day sessions, fresh login and immediate revocation
  test-policy       Prove central row-level policies against PostgreSQL/Twenty
  test-matching     Prove deterministic sponsor matching and confirmation
  test-assignments  Prove assignment concurrency, history and handover
  test-activities   Prove activity history and prioritized reminders
  test-pwa          Prove installable PWA, sponsor lists and responsive UX
  test-actions      Prove neutral CharityAction lifecycle and browser creation
  test-templates    Prove versioned action templates and previous-year copies
  test-action-admin Prove Charity-Admin action management and conflict handling
  test-public-actions
                    Prove public alias switching and immutable archive routes
  test-commitments  Prove offerings, quantities and server-priced commitments
  test-unit         Run unit tests with Golden Data domain objects
  test-integration  Rebuild and test real services from empty volumes
  test-e2e          Run all currently implemented real browser journeys
  seed              Idempotently seed Golden Dataset v1 into real systems
  snapshot [NAME]   Write a deterministic real-system snapshot under .local/
  reset             Safely reset all local core systems to Golden Dataset v1
  help              Show this help
EOF
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "leonaid: ERROR: Docker fehlt. Installiere/startet OrbStack oder Docker Desktop." >&2
    exit 1
  fi
  if ! docker version >/dev/null 2>&1; then
    echo "leonaid: ERROR: Docker ist nicht erreichbar. Starte OrbStack und wiederhole den Befehl." >&2
    exit 1
  fi
}

run_python() {
  docker run --rm \
    -e PYTHONPATH=/workspace/src \
    -e UV_CACHE_DIR=/workspace/.cache/uv \
    -e UV_LINK_MODE=copy \
    -v "$root:/workspace" \
    -w /workspace \
    "$UV_IMAGE" \
    "$@"
}

run_bun() {
  docker run --rm \
    -e BUN_INSTALL_CACHE_DIR=/workspace/.cache/bun \
    -v "$root:/workspace" \
    -w /workspace \
    "$BUN_IMAGE" \
    "$@"
}

compose() {
  integration_key=${TWENTY_INTEGRATION_API_KEY:-}
  if [ -z "$integration_key" ] && [ -f "$root/.local/twenty/integration.env" ]; then
    integration_key=$(sed -n 's/^TWENTY_INTEGRATION_API_KEY=//p' \
      "$root/.local/twenty/integration.env")
  fi
  TWENTY_INTEGRATION_API_KEY="$integration_key" docker compose \
    --project-name "${LEONAID_COMPOSE_PROJECT:-leonaid}" \
    --env-file "$root/.env.local" \
    --file "$root/infra/compose/compose.yml" \
    "$@"
}

bootstrap() {
  require_docker
  mkdir -p "$root/.cache"
  host_user_id=$(id -u)
  host_group_id=$(id -g)
  docker run --rm \
    --user "$host_user_id:$host_group_id" \
    -v "$root:/workspace" \
    -w /workspace \
    "$PYTHON_IMAGE" \
    python tools/dx/generate_secrets.py .env.example .env.local
  chmod 600 "$root/.env.local"
  run_python uv sync --frozen --all-groups --no-install-project
  run_bun bun install --frozen-lockfile --ignore-scripts
  echo "bootstrap: OK: ausschließlich gelockte Docker-Toolchains verwendet"
  "$root/leonaid" doctor
}

doctor() {
  require_docker
  failures=0

  if ! docker compose version >/dev/null 2>&1; then
    echo "doctor: FEHLER: Docker Compose Plugin fehlt. Aktualisiere OrbStack/Docker Desktop." >&2
    failures=$((failures + 1))
  else
    echo "doctor: OK: Docker und Compose erreichbar"
  fi

  if [ ! -f "$root/.env.local" ]; then
    echo "doctor: FEHLER: .env.local fehlt. Führe './leonaid bootstrap' aus." >&2
    failures=$((failures + 1))
  elif grep -E '__GENERATE_|change-me|CHANGE_ME' "$root/.env.local" >/dev/null 2>&1; then
    echo "doctor: FEHLER: .env.local enthält Vorlagenwerte. Lösche sie und führe './leonaid bootstrap' aus." >&2
    failures=$((failures + 1))
  elif git -C "$root" ls-files --error-unmatch .env.local >/dev/null 2>&1; then
    echo "doctor: FEHLER: .env.local ist versioniert. Entferne sie sofort aus dem Git-Index." >&2
    failures=$((failures + 1))
  elif ! git -C "$root" check-ignore -q .env.local; then
    echo "doctor: FEHLER: .env.local wird nicht von Git ignoriert. Prüfe .gitignore." >&2
    failures=$((failures + 1))
  elif ! docker run --rm \
    -v "$root:/workspace:ro" \
    "$PYTHON_IMAGE" \
    python /workspace/tools/dx/verify_secrets.py \
    /workspace/.env.example /workspace/.env.local; then
    echo "doctor: FEHLER: lokale Secrets sind unvollständig, zu kurz oder nicht eindeutig. Erzeuge sie mit './leonaid bootstrap' neu." >&2
    failures=$((failures + 1))
  else
    echo "doctor: OK: lokale Secrets vorhanden, generiert und ignoriert"
  fi

  if [ -f "$root/.env.local" ] && ! compose config --quiet; then
    echo "doctor: FEHLER: Compose-Konfiguration oder Umgebungsvariablen sind ungültig." >&2
    failures=$((failures + 1))
  elif [ -f "$root/.env.local" ]; then
    echo "doctor: OK: Compose-Corestack ist vollständig auflösbar"
  fi

  if [ ! -L "$root/.venv/bin/python" ] && [ ! -x "$root/.venv/bin/python" ]; then
    echo "doctor: FEHLER: Python-Umgebung fehlt. Führe './leonaid bootstrap' aus." >&2
    failures=$((failures + 1))
  else
    echo "doctor: OK: gelockte Python-Umgebung vorhanden"
  fi

  if [ ! -x "$root/node_modules/.bin/tsc" ]; then
    echo "doctor: FEHLER: Frontend-Pakete fehlen. Führe './leonaid bootstrap' aus." >&2
    failures=$((failures + 1))
  else
    echo "doctor: OK: gelockte Frontend-Pakete vorhanden"
  fi

  if ! docker run --rm \
    -v "$root:/workspace:ro" \
    "$PYTHON_IMAGE" \
    python /workspace/tools/pins/check.py /workspace; then
    echo "doctor: FEHLER: Dependency-Locks sind inkonsistent. Führe './leonaid check' aus." >&2
    failures=$((failures + 1))
  fi

  if [ "$failures" -ne 0 ]; then
    echo "doctor: FEHLGESCHLAGEN: $failures Problem(e), jeweils mit Korrekturhinweis." >&2
    exit 1
  fi
  echo "doctor: OK: Entwicklungsumgebung ist einsatzbereit"
}

check_clean_tree() {
  dirty=$(git -C "$root" status --porcelain --untracked-files=all)
  if [ -n "$dirty" ]; then
    echo "check: FEHLER: Arbeitsbaum ist nicht sauber; Prüfung würde Ursache und erzeugte Änderungen vermischen." >&2
    printf '%s\n' "$dirty" >&2
    echo "check: Committe/stashe Änderungen oder teste einen frischen Checkout." >&2
    exit 1
  fi
}

check_all() {
  require_docker
  check_clean_tree
  before=$(git -C "$root" status --porcelain --untracked-files=all)

  docker run --rm \
    -v "$root:/workspace:ro" \
    "$ALPINE_IMAGE" \
    /bin/sh /workspace/tools/traceability/test.sh /workspace
  docker run --rm \
    -v "$root:/workspace:ro" \
    "$PYTHON_IMAGE" \
    /bin/sh /workspace/tools/pins/test.sh /workspace
  docker run --rm \
    -v "$root:/workspace:ro" \
    "$PYTHON_IMAGE" \
    /bin/sh /workspace/tools/golden/test.sh /workspace
  run_python uv run --frozen --no-sync ruff check \
    migrations src tests tools/action_admin tools/actions tools/commitments \
    tools/activities tools/assignments \
    tools/compose/persistence_probe.py tools/core \
    tools/dx tools/identity tools/invitations tools/openapi tools/outbox \
    tools/matching tools/policy tools/public_actions tools/schema tools/seed tools/sessions \
    tools/pwa tools/templates tools/twenty
  run_python uv run --frozen --no-sync ruff format --check \
    migrations src tests tools/action_admin tools/actions tools/commitments \
    tools/activities tools/assignments tools/matching \
    tools/compose/persistence_probe.py tools/core \
    tools/dx tools/identity tools/invitations tools/openapi tools/outbox \
    tools/policy tools/public_actions tools/pwa tools/schema tools/seed tools/sessions \
    tools/templates tools/twenty
  run_python uv run --frozen --no-sync mypy \
    migrations src tools/action_admin tools/actions tools/activities \
    tools/assignments \
    tools/commitments \
    tools/compose/persistence_probe.py tools/core tools/dx \
    tools/identity tools/invitations tools/matching tools/openapi tools/outbox \
    tools/public_actions tools/pwa tools/schema tools/policy tools/seed tools/sessions tools/templates tools/twenty
  run_python uv run --frozen --no-sync pytest tests/unit
  run_python uv run --frozen --no-sync \
    python tools/openapi/generate.py --root /workspace --check
  run_python uv run --frozen --no-sync \
    python tools/openapi/check_frontend.py --root /workspace
  run_bun bun run typecheck
  run_bun bun node_modules/prettier/bin/prettier.cjs --check \
    apps/public apps/pwa apps/web packages/api-client packages/features packages/ui \
    tests/contract tests/e2e package.json

  after=$(git -C "$root" status --porcelain --untracked-files=all)
  if [ "$before" != "$after" ] || [ -n "$after" ]; then
    echo "check: FEHLER: Eine Prüfung hat den Arbeitsbaum verändert:" >&2
    git -C "$root" status --short >&2
    exit 1
  fi
  echo "check: OK: alle Gates grün; Arbeitsbaum unverändert"
}

future_command() {
  command_name=$1
  task=$2
  echo "leonaid: '$command_name' ist verdrahtet, wird aber erst mit $task ausführbar." >&2
  echo "leonaid: Nutze './leonaid help' für den aktuellen Meilenstein." >&2
  exit 64
}

dev() {
  require_docker
  if [ ! -f "$root/.env.local" ]; then
    echo "leonaid: ERROR: .env.local fehlt. Führe './leonaid bootstrap' aus." >&2
    exit 1
  fi
  compose up --build --detach --wait --wait-timeout 420
  port=$(sed -n 's/^LEONAID_HTTP_PORT=//p' "$root/.env.local" | tail -n 1)
  port=${port:-8080}
  https_port=$(sed -n 's/^LEONAID_HTTPS_PORT=//p' "$root/.env.local" | tail -n 1)
  https_port=${https_port:-8443}
  echo "dev: OK: LeonAid ist bereit unter https://localhost:$https_port (HTTP-Diagnose: http://127.0.0.1:$port)"
}

validate_reset_target() {
  project=${LEONAID_COMPOSE_PROJECT:-leonaid}
  compose --profile dev-mail config --format json |
    docker run --rm -i \
      -v "$root:/workspace:ro" \
      "$PYTHON_IMAGE" \
      python /workspace/tools/seed/safety.py \
      --project-name "$project" \
      --env-file /workspace/.env.local
}

render_golden_pdfs() {
  source_directory="$root/tests/fixtures/golden/v1/documents"
  output_directory="$root/.artifacts/golden-v1/invoices"
  mkdir -p "$output_directory"
  for source in "$source_directory"/KT26-*.typ; do
    filename=$(basename "$source" .typ)
    docker run --rm \
      -v "$source_directory:/input:ro" \
      -v "$output_directory:/output" \
      "$TYPST_IMAGE" \
      compile \
      --creation-timestamp 1782864000 \
      --jobs 1 \
      "/input/$filename.typ" \
      "/output/$filename.pdf"
  done
}

run_golden_tool() {
  compose --profile dev-mail run --rm --no-deps \
    --env-from-file "$root/.env.local" \
    --volume "$root:/repo:ro" \
    --volume "$root/.local:/repo/.local" \
    --entrypoint python \
    api /repo/tools/seed/golden.py "$@"
}

provision_twenty() {
  require_docker
  mkdir -p "$root/.local/twenty"
  host_user_id=$(id -u)
  host_group_id=$(id -g)
  compose build api
  compose up --detach --wait --wait-timeout 420 twenty-server twenty-worker
  compose run --rm --no-deps \
    --user "$host_user_id:$host_group_id" \
    --env-from-file "$root/.env.local" \
    --env PYTHONPATH=/repo:/workspace/src \
    --volume "$root:/repo:ro" \
    --volume "$root/.local:/repo/.local" \
    --workdir /repo \
    --entrypoint python \
    api tools/twenty/provision.py apply \
    --token-output /repo/.local/twenty/integration.env \
    --snapshot-output /repo/.local/twenty/schema-snapshot.json
  echo "provision-twenty: OK: lokaler Key liegt geschützt unter .local/twenty/integration.env und wird von ./leonaid automatisch verwendet"
}

import_crm() {
  require_docker
  if [ "$#" -lt 2 ]; then
    echo "leonaid: ERROR: Nutzung: ./leonaid import-crm <dry-run|apply> SOURCE --report .local/DATEI.json [--sheet NAME]" >&2
    exit 64
  fi
  case "$1" in
    dry-run|apply) ;;
    *)
      echo "leonaid: ERROR: Importmodus muss 'dry-run' oder 'apply' sein." >&2
      exit 64
      ;;
  esac
  if [ ! -f "$root/.local/twenty/integration.env" ]; then
    echo "leonaid: ERROR: Twenty-Key fehlt. Führe zuerst './leonaid provision-twenty' aus." >&2
    exit 1
  fi
  mkdir -p "$root/.local"
  host_user_id=$(id -u)
  host_group_id=$(id -g)
  compose build api
  compose up --detach --wait --wait-timeout 420 twenty-server twenty-worker
  compose run --rm --no-deps \
    --user "$host_user_id:$host_group_id" \
    --env-from-file "$root/.env.local" \
    --env-from-file "$root/.local/twenty/integration.env" \
    --env PYTHONPATH=/repo/src:/repo:/workspace/src \
    --volume "$root:/repo:ro" \
    --volume "$root/.local:/repo/.local" \
    --workdir /repo \
    --entrypoint python \
    api tools/twenty/import_contacts.py "$@"
}

seed_systems() {
  require_docker
  compose --profile dev-mail up --detach --wait --wait-timeout 420
  render_golden_pdfs
  mkdir -p "$root/.local"
  run_golden_tool seed \
    /repo/tests/fixtures/golden/v1 \
    /repo/.artifacts/golden-v1/invoices
}

snapshot_systems() {
  require_docker
  name=${1:-golden-v1.json}
  case "$name" in
    *[!A-Za-z0-9._-]* | .* | *..*)
      echo "snapshot: ERROR: NAME darf nur A-Z, a-z, 0-9, Punkt, Unterstrich und Bindestrich enthalten." >&2
      exit 64
      ;;
  esac
  mkdir -p "$root/.local/snapshots"
  run_golden_tool snapshot \
    /repo/tests/fixtures/golden/v1 \
    --output "/repo/.local/snapshots/$name"
}

reset_systems() {
  require_docker
  validate_reset_target
  compose --profile dev-mail down --volumes --remove-orphans
  compose --profile dev-mail up --build --detach --wait --wait-timeout 420
  seed_systems
  snapshot_systems golden-v1.json
  echo "reset: OK: Core-PostgreSQL, Twenty, RustFS und Mailpit entsprechen Golden Data v1"
}

command=${1:-help}
case "$command" in
  bootstrap) bootstrap ;;
  doctor) doctor ;;
  check) check_all ;;
  test-unit)
    require_docker
    run_python uv run --frozen --no-sync pytest tests/unit
    ;;
  dev) dev ;;
  test-integration)
    require_docker
    /bin/sh "$root/tools/compose/test.sh" "$root"
    /bin/sh "$root/tools/seed/test.sh" "$root"
    /bin/sh "$root/tools/core/test.sh" "$root"
    /bin/sh "$root/tools/schema/test.sh" "$root"
    /bin/sh "$root/tools/outbox/test.sh" "$root"
    /bin/sh "$root/tools/openapi/test.sh" "$root"
    /bin/sh "$root/tools/twenty/test.sh" "$root"
    /bin/sh "$root/tools/twenty/gateway_test.sh" "$root"
    /bin/sh "$root/tools/twenty/import_test.sh" "$root"
    /bin/sh "$root/tools/identity/test.sh" "$root"
    /bin/sh "$root/tools/invitations/test.sh" "$root"
    /bin/sh "$root/tools/sessions/test.sh" "$root"
    /bin/sh "$root/tools/policy/test.sh" "$root"
    /bin/sh "$root/tools/matching/test.sh" "$root"
    /bin/sh "$root/tools/assignments/test.sh" "$root"
    /bin/sh "$root/tools/activities/test.sh" "$root"
    /bin/sh "$root/tools/pwa/test.sh" "$root"
    /bin/sh "$root/tools/actions/test.sh" "$root"
    /bin/sh "$root/tools/templates/test.sh" "$root"
    /bin/sh "$root/tools/action_admin/test.sh" "$root"
    /bin/sh "$root/tools/public_actions/test.sh" "$root"
    /bin/sh "$root/tools/commitments/test.sh" "$root"
    ;;
  test-e2e)
    /bin/sh "$root/tools/identity/test.sh" "$root"
    /bin/sh "$root/tools/invitations/test.sh" "$root"
    /bin/sh "$root/tools/sessions/test.sh" "$root"
    /bin/sh "$root/tools/actions/test.sh" "$root"
    /bin/sh "$root/tools/action_admin/test.sh" "$root"
    /bin/sh "$root/tools/matching/test.sh" "$root"
    /bin/sh "$root/tools/assignments/test.sh" "$root"
    /bin/sh "$root/tools/activities/test.sh" "$root"
    /bin/sh "$root/tools/pwa/test.sh" "$root"
    /bin/sh "$root/tools/public_actions/test.sh" "$root"
    ;;
  test-twenty-gateway) /bin/sh "$root/tools/twenty/gateway_test.sh" "$root" ;;
  test-crm-import) /bin/sh "$root/tools/twenty/import_test.sh" "$root" ;;
  test-identity) /bin/sh "$root/tools/identity/test.sh" "$root" ;;
  test-invitations) /bin/sh "$root/tools/invitations/test.sh" "$root" ;;
  test-sessions) /bin/sh "$root/tools/sessions/test.sh" "$root" ;;
  test-policy) /bin/sh "$root/tools/policy/test.sh" "$root" ;;
  test-matching) /bin/sh "$root/tools/matching/test.sh" "$root" ;;
  test-assignments) /bin/sh "$root/tools/assignments/test.sh" "$root" ;;
  test-activities) /bin/sh "$root/tools/activities/test.sh" "$root" ;;
  test-pwa) /bin/sh "$root/tools/pwa/test.sh" "$root" ;;
  test-actions) /bin/sh "$root/tools/actions/test.sh" "$root" ;;
  test-templates) /bin/sh "$root/tools/templates/test.sh" "$root" ;;
  test-action-admin) /bin/sh "$root/tools/action_admin/test.sh" "$root" ;;
  test-public-actions) /bin/sh "$root/tools/public_actions/test.sh" "$root" ;;
  test-commitments) /bin/sh "$root/tools/commitments/test.sh" "$root" ;;
  generate-api-client)
    require_docker
    run_python uv run --frozen --no-sync \
      python tools/openapi/generate.py --root /workspace
    ;;
  provision-twenty) provision_twenty ;;
  import-crm)
    shift
    import_crm "$@"
    ;;
  seed) seed_systems ;;
  snapshot) snapshot_systems "${2:-golden-v1.json}" ;;
  reset) reset_systems ;;
  help|-h|--help) usage ;;
  *)
    echo "leonaid: Unbekannter Befehl '$command'." >&2
    usage >&2
    exit 64
    ;;
esac
