  docker run --rm \
    -v "$root:/workspace:ro" \
    "$PYTHON_IMAGE" \
    python /workspace/tools/pilot_decisions/check.py /workspace --ready "$@"
}

pilot_future_command() {
  command_name=$1
  task=$2
  pilot_doctor --gate "$command_name"
  future_command "$command_name" "$task"
}

dev() {
  require_docker
  if [ ! -f "$root/.env.local" ]; then
    echo "leonaid: ERROR: .env.local fehlt. Führe './leonaid bootstrap' aus." >&2
    exit 1
  fi
  compose up --build --detach --wait --wait-timeout 420
  port=$(sed -n 's/^LEONAID_HTTP_PORT=//p' "$root/.env.local" | tail -n 1)
  port=${port:-8080}
  https_port=$(sed -n 's/^LEONAID_HTTPS_PORT=//p' "$root/.env.local" | tail -n 1)
  https_port=${https_port:-8443}
  echo "dev: OK: LeonAid ist bereit unter https://localhost:$https_port (HTTP-Diagnose: http://127.0.0.1:$port)"
}

validate_reset_target() {
  project=${LEONAID_COMPOSE_PROJECT:-leonaid}
  compose --profile dev-mail config --format json |
    docker run --rm -i \
      -v "$root:/workspace:ro" \
      "$PYTHON_IMAGE" \
      python /workspace/tools/seed/safety.py \
      --project-name "$project" \
      --env-file /workspace/.env.local
}

render_golden_pdfs() {
  output_directory="$root/.artifacts/golden-v1/invoices"
  api_image=$(compose images -q api)
  if [ -z "$api_image" ]; then
    echo "seed: ERROR: gebautes Core-Image für Typst fehlt" >&2
    exit 1
  fi
  /bin/sh "$root/tools/typst/render_golden.sh" \
    "$root" "$output_directory" "$api_image"
}

run_golden_tool() {
  compose --profile dev-mail run --rm --no-deps \
    --env-from-file "$root/.env.local" \
    --volume "$root:/repo:ro" \
    --volume "$root/.local:/repo/.local" \
    --entrypoint python \
    api /repo/tools/seed/golden.py "$@"
}

provision_twenty() {
  require_docker
  mkdir -p "$root/.local/twenty"
  host_user_id=$(id -u)
  host_group_id=$(id -g)
  staged_directory=$(mktemp -d "$root/.local/twenty/provision.XXXXXX")
  staged_name=${staged_directory##*/}
  staged_token="$staged_directory/integration.env"
  container_staged_token="/repo/.local/twenty/$staged_name/integration.env"
  compose build api
  compose up --detach --wait --wait-timeout 420 twenty-server twenty-worker
  if ! compose run --rm --no-deps \
    --user "$host_user_id:$host_group_id" \
    --env-from-file "$root/.env.local" \
    --env PYTHONPATH=/repo:/workspace/src \
    --volume "$root:/repo:ro" \
    --volume "$root/.local:/repo/.local" \
    --workdir /repo \
    --entrypoint python \
    api tools/twenty/provision.py apply \
    --token-output "$container_staged_token" \
    --snapshot-output /repo/.local/twenty/schema-snapshot.json; then
    rm -f "$staged_token"
    rmdir "$staged_directory"
    return 1
  fi
  if ! compose run --rm --no-deps \
    --user "$host_user_id:$host_group_id" \
    --env-from-file "$root/.env.local" \
    --env PYTHONPATH=/repo:/workspace/src \
    --volume "$root:/repo:ro" \
    --volume "$root/.local:/repo/.local" \
    --workdir /repo \
    --entrypoint python \
    api tools/twenty/provision.py verify-key \
    --token-file "$container_staged_token"; then
    rm -f "$staged_token"
    rmdir "$staged_directory"
    return 1
  fi
  mv "$staged_token" "$root/.local/twenty/integration.env"
  rmdir "$staged_directory"
  echo "provision-twenty: OK: deklarationsgleicher, real verifizierter Key liegt geschützt unter .local/twenty/integration.env und wird von ./leonaid automatisch verwendet"
}

import_crm() {
  require_docker
  if [ "$#" -lt 2 ]; then
    echo "leonaid: ERROR: Nutzung: ./leonaid import-crm <dry-run|apply> SOURCE --report .local/DATEI.json [--sheet NAME]" >&2
    exit 64
  fi
  case "$1" in
    dry-run|apply) ;;
    *)
      echo "leonaid: ERROR: Importmodus muss 'dry-run' oder 'apply' sein." >&2
      exit 64
      ;;
  esac
  if [ ! -f "$root/.local/twenty/integration.env" ]; then
    echo "leonaid: ERROR: Twenty-Key fehlt. Führe zuerst './leonaid provision-twenty' aus." >&2
    exit 1
  fi
  mkdir -p "$root/.local"
  host_user_id=$(id -u)
  host_group_id=$(id -g)
  compose build api
  compose up --detach --wait --wait-timeout 420 twenty-server twenty-worker
  compose run --rm --no-deps \
    --user "$host_user_id:$host_group_id" \
    --env-from-file "$root/.env.local" \
    --env-from-file "$root/.local/twenty/integration.env" \
    --env PYTHONPATH=/repo/src:/repo:/workspace/src \
    --volume "$root:/repo:ro" \
    --volume "$root/.local:/repo/.local" \
    --workdir /repo \
    --entrypoint python \
    api tools/twenty/import_contacts.py "$@"
}

seed_systems() {
  require_docker
  compose --profile dev-mail up --detach --wait --wait-timeout 420
  render_golden_pdfs
  mkdir -p "$root/.local"
  run_golden_tool seed \
    /repo/tests/fixtures/golden/v1 \
    /repo/.artifacts/golden-v1/invoices
  generate_test_logins
}

snapshot_systems() {
  require_docker
  name=${1:-golden-v1.json}
  case "$name" in
    *[!A-Za-z0-9._-]* | .* | *..*)
      echo "snapshot: ERROR: NAME darf nur A-Z, a-z, 0-9, Punkt, Unterstrich und Bindestrich enthalten." >&2
      exit 64
      ;;
  esac
  mkdir -p "$root/.local/snapshots"
  run_golden_tool snapshot \
    /repo/tests/fixtures/golden/v1 \
    --output "/repo/.local/snapshots/$name"
}

reset_systems() {
  require_docker
  validate_reset_target
  compose --profile dev-mail down --volumes --remove-orphans
  rm -f "$root/.local/twenty/integration.env"
  compose --profile dev-mail up --build --detach --wait --wait-timeout 420
  provision_twenty
  compose --profile dev-mail up --detach --force-recreate \
    --wait --wait-timeout 420 api worker
  seed_systems
  snapshot_systems golden-v1.json
  echo "reset: OK: Core-PostgreSQL, Twenty, RustFS und Mailpit entsprechen Golden Data v1"
}

