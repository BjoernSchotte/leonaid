}

mail_domain_check() (
  require_docker
  expectation=
  report=
  json_argument=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --expectation)
        [ "$#" -ge 2 ] || {
          echo "mail-domain-check: ERROR: --expectation benötigt einen Pfad" >&2
          exit 64
        }
        expectation=$2
        shift 2
        ;;
      --report)
        [ "$#" -ge 2 ] || {
          echo "mail-domain-check: ERROR: --report benötigt einen Pfad" >&2
          exit 64
        }
        report=$2
        shift 2
        ;;
      --json)
        json_argument=--json
        shift
        ;;
      *)
        echo "mail-domain-check: ERROR: unbekannte Option '$1'" >&2
        exit 64
        ;;
    esac
  done
  [ -n "$expectation" ] || {
    echo "mail-domain-check: BLOCKED: --expectation fehlt" >&2
    exit 2
  }
  [ -f "$expectation" ] || {
    echo "mail-domain-check: BLOCKED: Erwartungsdatei fehlt" >&2
    exit 2
  }
  expectation=$(
    CDPATH= cd -- "$(dirname -- "$expectation")" &&
      pwd
  )/$(basename -- "$expectation")
  if [ -n "$report" ]; then
    mkdir -p "$(dirname -- "$report")"
    report=$(
      CDPATH= cd -- "$(dirname -- "$report")" &&
        pwd
    )/$(basename -- "$report")
  fi

  private_workspace=$(mktemp -d)
  cleanup_mail_domain_check() {
    rm -rf "$private_workspace"
  }
  trap cleanup_mail_domain_check EXIT HUP INT TERM
  cp "$expectation" "$private_workspace/expectation.json"

  if [ -n "$json_argument" ] && [ -n "$report" ]; then
    docker run --rm \
      -e PYTHONPATH=/workspace:/workspace/src \
      -e UV_CACHE_DIR=/tmp/uv-cache \
      -e UV_LINK_MODE=copy \
      -v "$root:/workspace:ro" \
      -v "$private_workspace:/private" \
      -w /workspace \
      "$UV_IMAGE" \
      uv run --frozen --no-sync \
      python tools/mail_domain/check.py \
      --expectation /private/expectation.json \
      --json \
      --report /private/report.json
  elif [ -n "$json_argument" ]; then
    docker run --rm \
      -e PYTHONPATH=/workspace:/workspace/src \
      -e UV_CACHE_DIR=/tmp/uv-cache \
      -e UV_LINK_MODE=copy \
      -v "$root:/workspace:ro" \
      -v "$private_workspace:/private" \
      -w /workspace \
      "$UV_IMAGE" \
      uv run --frozen --no-sync \
      python tools/mail_domain/check.py \
      --expectation /private/expectation.json \
      --json
  elif [ -n "$report" ]; then
    docker run --rm \
      -e PYTHONPATH=/workspace:/workspace/src \
      -e UV_CACHE_DIR=/tmp/uv-cache \
      -e UV_LINK_MODE=copy \
      -v "$root:/workspace:ro" \
      -v "$private_workspace:/private" \
      -w /workspace \
      "$UV_IMAGE" \
      uv run --frozen --no-sync \
      python tools/mail_domain/check.py \
      --expectation /private/expectation.json \
      --report /private/report.json
  else
    docker run --rm \
      -e PYTHONPATH=/workspace:/workspace/src \
      -e UV_CACHE_DIR=/tmp/uv-cache \
      -e UV_LINK_MODE=copy \
      -v "$root:/workspace:ro" \
      -v "$private_workspace:/private" \
      -w /workspace \
      "$UV_IMAGE" \
      uv run --frozen --no-sync \
      python tools/mail_domain/check.py \
      --expectation /private/expectation.json
  fi

  if [ -n "$report" ]; then
    cp "$private_workspace/report.json" "$report"
    chmod 600 "$report"
  fi
)

