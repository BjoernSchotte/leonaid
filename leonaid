        ;;
    esac
  done
  [ -n "$env_file" ] || {
    echo "pilot-restore: ERROR: --env-file fehlt" >&2
    exit 64
  }
  [ -n "$backup_manifest" ] || {
    echo "pilot-restore: ERROR: --backup-manifest fehlt" >&2
    exit 64
  }
  [ -n "$target_env_file" ] || {
    echo "pilot-restore: ERROR: --target-env-file fehlt" >&2
    exit 64
  }
  [ -n "$password_file" ] || {
    echo "pilot-restore: ERROR: --password-file fehlt" >&2
    exit 64
  }
  [ -n "$confirm" ] || {
    echo "pilot-restore: ERROR: --confirm fehlt" >&2
    exit 64
  }
  env_file=$(pilot_absolute_file pilot-restore "$env_file")
  backup_manifest=$(pilot_absolute_file pilot-restore "$backup_manifest")
  target_env_file=$(pilot_absolute_file pilot-restore "$target_env_file")
  password_file=$(pilot_absolute_file pilot-restore "$password_file")
  if [ -n "$credentials_file" ]; then
    credentials_file=$(pilot_absolute_file pilot-restore "$credentials_file")
  fi
  source_project=$(pilot_environment_value LEONAID_COMPOSE_PROJECT "$env_file")
