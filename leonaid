    --env "EXPECTED_PROJECT=$project" \
    --volume "$manifest_check_directory:/pilot:ro" \
    "$PYTHON_IMAGE" \
    python -c 'import json,os,pathlib
value=json.loads(pathlib.Path("/pilot/backup-manifest.json").read_text(encoding="utf-8"))
assert value.get("schemaVersion")==1
assert value.get("sourceProject")==os.environ["EXPECTED_PROJECT"]
assert set(value.get("files",{}))=={
  "core.dump","twenty.dump","twenty-storage.tar","rustfs-data.tar"
}'; then
    rm -rf "$manifest_check_directory"
  else
    status=$?
    rm -rf "$manifest_check_directory"
    return "$status"
  fi
  pilot_doctor \
    --env-file "$env_file" \
    --backup-manifest "$backup_manifest" \
    --gate pilot-backup
  echo "pilot-backup: OK: $project ist verschlüsselt gesichert und das Doctor-Manifest ist aktuell"
}

