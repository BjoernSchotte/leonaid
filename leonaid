        --resolve "$portal_domain=127.0.0.1:443" \
        --resolve "$crm_domain=127.0.0.1:443" \
        --disk-path /workspace \
        --minimum-free-bytes 1048576 \
        --minimum-certificate-validity-hours 1 $json_argument
  else
    # shellcheck disable=SC2086
    docker run --rm \
      --env PYTHONPATH=/workspace \
      --volume "$root:/workspace:ro" \
      --volume "$env_file:/doctor/production.env:ro" \
      --volume "$doctor_input_directory:/doctor/input:ro" \
