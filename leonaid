    LEONAID_BACKUP_PASSWORD_FILE="$password_file" \
    LEONAID_BACKUP_CREDENTIALS_FILE="$credentials_file" \
    LEONAID_BACKUP_ALLOW_LOCAL_TEST="${LEONAID_PILOT_TEST_ALLOW_LOCAL_BACKUP:-false}" \
    LEONAID_RESTORE_COMPOSE_OVERLAY="$root/infra/pilot/compose.yml" \
    LEONAID_RESTORE_COMPOSE_OVERLAY_SECONDARY="$restore_overlay_secondary" \
    LEONAID_RESTORE_NO_BUILD=true \
    LEONAID_RESTORE_PROFILE=none \
    /bin/sh "$root/tools/backup/restore.sh" "$root"
  echo "pilot-restore: OK: $source_project wurde buildfrei nach $target_project restauriert"
}

pilot_import() {
  require_docker
  [ "$#" -ge 2 ] || {
    echo "pilot-import: ERROR: Nutzung: ./leonaid pilot-import <dry-run|apply|verify> SOURCE --env-file FILE --manifest FILE --mapping FILE --batch-id ID --target-environment ENV --sheet NAME --report FILE" >&2
    exit 64
  }
  mode=$1
  case "$mode" in
    dry-run|apply|verify) ;;
    *)
      echo "pilot-import: ERROR: Modus muss dry-run, apply oder verify sein" >&2
      exit 64
      ;;
  esac
  env_file=
  backup_manifest=
  target_environment=
  previous=
  for argument in "$@"; do
    case "$previous" in
      --env-file) env_file=$argument ;;
      --backup-manifest) backup_manifest=$argument ;;
      --target-environment) target_environment=$argument ;;
    esac
    previous=$argument
  done
  [ -n "$env_file" ] || {
    echo "pilot-import: ERROR: --env-file fehlt" >&2
    exit 64
  }
  [ -f "$env_file" ] || {
    echo "pilot-import: ERROR: Environment-Datei fehlt" >&2
    exit 1
  }
  if [ "$mode" = apply ] || [ "$mode" = verify ]; then
    [ -n "$backup_manifest" ] || {
      echo "pilot-import: ERROR: --backup-manifest fehlt für $mode" >&2
      exit 64
    }
    pilot_doctor \
      --env-file "$env_file" \
      --backup-manifest "$backup_manifest" \
      --gate pilot-import
  fi
  project=$(sed -n 's/^LEONAID_COMPOSE_PROJECT=//p' "$env_file" | tail -n 1)
  case "$project" in
    leonaid-production*|leonaid-staging*) ;;
    *)
      echo "pilot-import: BLOCKED: Compose-Projekt ist nicht staging-/produktionsspezifisch" >&2
      exit 1
      ;;
  esac
  [ -n "$target_environment" ] || {
    echo "pilot-import: ERROR: --target-environment fehlt" >&2
    exit 64
  }
  if [ "$project" != "leonaid-$target_environment" ]; then
    echo "pilot-import: BLOCKED: Zielumgebung stimmt nicht mit LEONAID_COMPOSE_PROJECT überein" >&2
    exit 1
  fi
  host_user_id=$(id -u)
  host_group_id=$(id -g)
  docker compose \
    --project-name "$project" \
    --env-file "$env_file" \
    --file "$root/infra/compose/compose.yml" \
    --file "$root/infra/pilot/compose.yml" \
    run --rm --no-deps --no-build \
    --user "$host_user_id:$host_group_id" \
    --env PYTHONPATH=/repo/src:/repo:/workspace/src \
    --volume "$root:/repo:ro" \
    --volume "$root/.local:/repo/.local" \
    --workdir /repo \
    --entrypoint python \
    api tools/pilot_import/protocol.py "$@" --root /repo
}

pilot_release_manifest() {
  [ "$#" -ge 1 ] || {
    echo "pilot-release-manifest: ERROR: create oder verify fehlt" >&2
