    echo "pilot-restore: BLOCKED: Quell- und Zielkonfiguration verwenden verschiedene Backup-Repositories" >&2
    exit 1
  }
  case "$target_project" in
    leonaid-restore-*) ;;
    *)
      echo "pilot-restore: BLOCKED: Zielprojekt muss leonaid-restore-<name> heißen" >&2
      exit 1
      ;;
  esac
  [ "$confirm" = "RESTORE:$target_project" ] || {
    echo "pilot-restore: BLOCKED: --confirm muss exakt RESTORE:$target_project sein" >&2
    exit 1
  }
  pilot_doctor \
    --env-file "$env_file" \
    --backup-manifest "$backup_manifest" \
    --gate pilot-restore
  restore_overlay_secondary=
  if [ -n "${LEONAID_PILOT_TEST_RESTORE_OVERLAY:-}" ]; then
    restore_overlay_secondary=${LEONAID_PILOT_TEST_RESTORE_OVERLAY}
    case "$source_project" in
