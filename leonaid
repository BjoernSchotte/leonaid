pilot_doctor() {
  require_docker
  env_file=
  backup_manifest=
  gate=pilot-release
  json_argument=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --env-file)
        [ "$#" -ge 2 ] || {
          echo "pilot-doctor: ERROR: --env-file benötigt einen Pfad" >&2
          exit 64
        }
        env_file=$2
        shift 2
        ;;
      --backup-manifest)
        [ "$#" -ge 2 ] || {
          echo "pilot-doctor: ERROR: --backup-manifest benötigt einen Pfad" >&2
          exit 64
        }
        backup_manifest=$2
        shift 2
        ;;
      --gate)
        [ "$#" -ge 2 ] || {
          echo "pilot-doctor: ERROR: --gate benötigt einen Wert" >&2
          exit 64
        }
        gate=$2
        shift 2
        ;;
      --json)
        json_argument=--json
        shift
        ;;
      *)
        echo "pilot-doctor: ERROR: unbekannte Option '$1'" >&2
        exit 64
        ;;
    esac
  done
  [ -n "$env_file" ] || {
    echo "pilot-doctor: BLOCKED: --env-file mit privater 0600-Konfiguration fehlt" >&2
    exit 1
  }
  [ -n "$backup_manifest" ] || {
    echo "pilot-doctor: BLOCKED: --backup-manifest des letzten Backups fehlt" >&2
    exit 1
  }
  [ -f "$env_file" ] || {
    echo "pilot-doctor: BLOCKED: Environment-Datei fehlt" >&2
    exit 1
  }
  [ -f "$backup_manifest" ] || {
    echo "pilot-doctor: BLOCKED: Backup-Manifest fehlt" >&2
    exit 1
  }
  env_file=$(CDPATH= cd -- "$(dirname -- "$env_file")" && pwd)/$(basename -- "$env_file")
  backup_manifest=$(
    CDPATH= cd -- "$(dirname -- "$backup_manifest")" &&
      pwd
  )/$(basename -- "$backup_manifest")
  project=$(sed -n 's/^LEONAID_COMPOSE_PROJECT=//p' "$env_file" | tail -n 1)
  case "$project" in
    leonaid-production*|leonaid-staging*) ;;
    *)
      echo "pilot-doctor: BLOCKED: Compose-Projekt ist nicht umgebungsspezifisch" >&2
      exit 1
      ;;
  esac
  release_commit=$(git -C "$root" rev-parse HEAD)
  alert_webhook_file=$(
    pilot_environment_value LEONAID_ALERT_WEBHOOK_URL_FILE "$env_file"
  )
  monitored_disk_path=$(
    pilot_environment_value LEONAID_MONITORED_DISK_PATH "$env_file"
  )
  case "$alert_webhook_file" in
    /*) ;;
    *)
      echo "pilot-doctor: BLOCKED: Alert-Webhook-Pfad muss absolut sein" >&2
      return 1
      ;;
  esac
  case "$monitored_disk_path" in
    /*) ;;
    *)
      echo "pilot-doctor: BLOCKED: Monitoring-Pfad muss absolut sein" >&2
      return 1
      ;;
  esac
  [ -f "$alert_webhook_file" ] || {
    echo "pilot-doctor: BLOCKED: Alert-Webhook-Datei fehlt" >&2
    return 1
  }
  [ -d "$monitored_disk_path" ] || {
    echo "pilot-doctor: BLOCKED: Monitoring-Pfad fehlt" >&2
    return 1
  }
  config_file=$(mktemp)
  doctor_input_directory=$(mktemp -d)
  cp "$backup_manifest" "$doctor_input_directory/backup-manifest.json"
  trap 'rm -f "$config_file"; rm -rf "$doctor_input_directory"' EXIT HUP INT TERM
  pilot_compose_config "$project" "$env_file" "$config_file"
  set +e
  test_network=${LEONAID_PILOT_TEST_DOCTOR_NETWORK:-}
  test_ca_file=${LEONAID_PILOT_TEST_CA_FILE:-}
  test_decisions_file=${LEONAID_PILOT_TEST_DECISIONS_FILE:-}
  if [ -n "$test_network$test_ca_file$test_decisions_file" ]; then
    case "$project" in
      leonaid-production-test|leonaid-staging-test) ;;
      *)
        echo "pilot-doctor: BLOCKED: Testdiagnose ist nur in isolierten Testprojekten zulässig" >&2
        rm -f "$config_file"
        rm -rf "$doctor_input_directory"
        trap - EXIT HUP INT TERM
        return 1
        ;;
    esac
    if [ -z "$test_network" ] || [ -z "$test_ca_file" ] || [ -z "$test_decisions_file" ]; then
      echo "pilot-doctor: BLOCKED: Testdiagnose benötigt Netzwerk, CA und Entscheidungsregister" >&2
      rm -f "$config_file"
      rm -rf "$doctor_input_directory"
      trap - EXIT HUP INT TERM
      return 1
    fi
    test_ca_file=$(pilot_absolute_file pilot-doctor "$test_ca_file") || {
      rm -f "$config_file"
      rm -rf "$doctor_input_directory"
      trap - EXIT HUP INT TERM
      return 1
    }
    test_decisions_file=$(
      pilot_absolute_file pilot-doctor "$test_decisions_file"
    ) || {
      rm -f "$config_file"
      rm -rf "$doctor_input_directory"
      trap - EXIT HUP INT TERM
      return 1
    }
    portal_domain=$(pilot_environment_value LEONAID_PUBLIC_DOMAIN "$env_file")
    crm_domain=$(pilot_environment_value TWENTY_PUBLIC_DOMAIN "$env_file")
    # Test-only: same real TLS endpoints and decision parser, isolated inside
    # the proxy network namespace. Product projects cannot activate this path.
    # shellcheck disable=SC2086
    docker run --rm \
      --network "$test_network" \
      --env PYTHONPATH=/workspace \
      --volume "$root:/workspace:ro" \
      --volume "$test_decisions_file:/workspace/specs/leonaid-pilot/DECISIONS.md:ro" \
      --volume "$env_file:/doctor/production.env:ro" \
      --volume "$doctor_input_directory:/doctor/input:ro" \
      --volume "$config_file:/doctor/compose.json:ro" \
      --volume "$test_ca_file:/doctor/ca.crt:ro" \
      --volume "$alert_webhook_file:$alert_webhook_file:ro" \
      --volume "$monitored_disk_path:$monitored_disk_path:ro" \
      --workdir /workspace \
      "$PYTHON_IMAGE" \
      python tools/pilot_deployment/doctor.py /workspace \
        --env-file /doctor/production.env \
