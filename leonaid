require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "leonaid: ERROR: Docker fehlt. Installiere/startet OrbStack oder Docker Desktop." >&2
    exit 1
  fi
  if ! docker version >/dev/null 2>&1; then
    echo "leonaid: ERROR: Docker ist nicht erreichbar. Starte OrbStack und wiederhole den Befehl." >&2
    exit 1
  fi
}

docker_retry() {
  attempt=1
  max_attempts=3

  while :; do
    if "$@"; then
      return 0
    else
      status=$?
    fi
    if [ "$status" -ne 125 ] || [ "$attempt" -ge "$max_attempts" ]; then
      return "$status"
    fi
    attempt=$((attempt + 1))
    echo "leonaid: Docker-Registry/Daemon vorübergehend nicht erreichbar; Versuch $attempt/$max_attempts …" >&2
    sleep 2
  done
}

run_python() {
  docker_retry docker run --rm \
    -e PYTHONPATH=/workspace/src \
    -e UV_CACHE_DIR=/workspace/.cache/uv \
    -e UV_LINK_MODE=copy \
    -v "$root:/workspace" \
    -w /workspace \
    "$UV_IMAGE" \
    "$@"
}

run_bun() {
  docker_retry docker run --rm \
    -e BUN_INSTALL_CACHE_DIR=/workspace/.cache/bun \
    -v "$root:/workspace" \
    -w /workspace \
    "$BUN_IMAGE" \
    "$@"
}

