{
  "id": "/app/",
  "name": "LeonAid Akquise",
  "short_name": "LeonAid",
  "description": "Mobiler Arbeitsbereich für Sponsor-Akquise und Charity-Aktionen.",
  "lang": "de-DE",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f5f7fb",
  "theme_color": "#0d2240",
  "orientation": "any",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/app/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/app/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Meine Sponsoren",
      "short_name": "Sponsoren",
      "url": "/app/sponsors",
      "icons": [
        {
          "src": "/app/icons/icon-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Aktivität erfassen",
      "short_name": "Aktivität",
      "url": "/app/activities",
      "icons": [
        {
          "src": "/app/icons/icon-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
