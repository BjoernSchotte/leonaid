---
import PublicLayout from "../../layouts/PublicLayout.astro";
import "../../styles/survey.css";
const { surveyId } = Astro.params;
if (!surveyId || !/^[0-9a-f-]{36}$/i.test(surveyId))
  return new Response("Nicht gefunden", { status: 404 });
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
---

<PublicLayout
  title="Ihre Rückmeldung | LeonAid"
  description="Ihre Meinung zur Lions-Aktion"
  canonicalUrl={Astro.url.origin + Astro.url.pathname}
  imageUrl=""
  robots="noindex,nofollow"
>
  <div class="site-shell survey-shell">
    <div data-survey-host data-survey-id={surveyId}>
      <p role="status">Fragebogen wird geladen …</p>
    </div>
    <noscript
      >Bitte aktivieren Sie JavaScript, um an dieser Umfrage teilzunehmen.</noscript
    >
  </div>
</PublicLayout>
<script>
  import "../../lib/survey-page";
</script>
