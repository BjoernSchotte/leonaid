---
import { actions } from "astro:actions";

import PublicAction from "../components/PublicAction.astro";
import PublicCampaignList from "../components/PublicCampaignList.astro";
import PublicInbox from "../components/PublicInbox.astro";
import PublicState from "../components/PublicState.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { resolvePublicTheme } from "../themes";
import { campaignRedirect } from "../lib/campaign-redirect";
import {
  adminOnlyTarget,
  canonicalRedirect,
  hasPublicHost,
} from "../lib/site-hosts";
import { moduleEnabled } from "../lib/modules";
import { listActiveCampaigns } from "../lib/core";

const rawPath = Astro.params.path ?? "";
const publicOrderResult = Astro.getActionResult(actions.createPublicOrder);
const segments = rawPath.split("/").filter(Boolean);
const slugPattern = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;

let state: "home" | "inactive" | "not-found" | "unavailable" | "action" =
  "home";
let route = null;

// Without a general public host (§6.6, review N4) the admin host never
// renders campaign or alias pages: it redirects to the campaign host or
// answers 404.
if (!hasPublicHost()) {
  const target = adminOnlyTarget(segments);
  if (target === null)
    return new Response("Not Found", {
      status: 404,
      headers: { "Cache-Control": "no-store" },
    });
  const result = await Astro.callAction(actions.resolvePublicAction, target);
  if (result.error && result.error.code !== "NOT_FOUND")
    return new Response("Vorübergehend nicht erreichbar", {
      status: 503,
      headers: { "Cache-Control": "no-store", "Retry-After": "30" },
    });
  if (
    !result.error &&
    result.data.campaignHostUrl &&
    ["GET", "HEAD"].includes(Astro.request.method)
  )
    return canonicalRedirect(result.data.campaignHostUrl);
  return new Response("Not Found", {
    status: 404,
    headers: { "Cache-Control": "no-store" },
  });
}

if (segments.length > 0) {
  const routeKind =
    segments.length === 2 && segments[0] === "archive"
      ? "archive"
      : segments.length === 1
        ? "alias"
        : null;
  const routeValue =
    routeKind === "archive"
      ? segments[1]
      : routeKind === "alias"
        ? segments[0]
        : null;

  if (!routeKind || !routeValue || !slugPattern.test(routeValue)) {
    state = "not-found";
  } else {
    const result = await Astro.callAction(actions.resolvePublicAction, {
      routeKind,
      routeValue,
    });
    if (result.error) {
      state = result.error.code === "NOT_FOUND" ? "not-found" : "unavailable";
    } else if (
      result.data.campaignHostUrl &&
      ["GET", "HEAD"].includes(Astro.request.method)
    ) {
      // The action lives on a campaign host: its alias and archive page on
      // this host redirect to the canonical URL (specs/multi-domain §7.7.3).
      return canonicalRedirect(result.data.campaignHostUrl);
    } else if (result.data.availability === "inactive") {
      state = "inactive";
    } else {
      const redirect = campaignRedirect(result.data, Astro.request.method);
      if (redirect) return redirect;
      state = "action";
      route = result.data;
    }
  }
}

// The home page lists every active campaign (specs/multi-domain §6.5).
const campaigns = state === "home" ? await listActiveCampaigns() : [];

if (state === "not-found") {
  Astro.response.status = 404;
} else if (state === "unavailable") {
  Astro.response.status = 503;
} else {
  Astro.response.status = 200;
}

Astro.response.headers.set(
  "Cache-Control",
  segments.length === 1
    ? "no-store"
    : state === "action" && route?.submissionsAllowed
      ? "private, no-store"
      : state === "action" && route?.availability === "archive"
        ? "public, max-age=300, stale-while-revalidate=3600"
        : state === "action" || state === "inactive"
          ? "public, max-age=15, stale-while-revalidate=30"
          : state === "unavailable"
            ? "no-store"
            : "public, max-age=60",
);
Astro.response.headers.set(
  "X-LeonAid-Public-State",
  state === "action" && route ? route.availability : state,
);

const title =
  state === "action" && route?.action
    ? `${route.action.name} · LeonAid`
    : state === "inactive"
      ? "Derzeit keine aktive Aktion · LeonAid"
      : state === "not-found"
        ? "Aktionsseite nicht gefunden · LeonAid"
        : state === "unavailable"
          ? "Aktionsseite vorübergehend nicht erreichbar · LeonAid"
          : "Engagement, das ankommt · LeonAid";
const description =
  state === "action" && route?.action
    ? route.action.purpose
    : state === "inactive"
      ? "Unter dieser Adresse ist derzeit keine Charity-Aktion veröffentlicht."
      : "LeonAid verbindet lokale Charity-Aktionen mit Menschen, die vor Ort helfen.";
const canonicalPath =
  state === "action" && route ? route.canonicalPath : `/${rawPath}`;
const forwardedProtocol = Astro.request.headers
  .get("x-forwarded-proto")
  ?.split(",", 1)[0]
  ?.trim();
const publicOrigin = new URL(Astro.url.origin);
if (forwardedProtocol === "http" || forwardedProtocol === "https") {
  publicOrigin.protocol = `${forwardedProtocol}:`;
}
const canonicalUrl = new URL(canonicalPath || "/", publicOrigin).href;
// The theme is data on the action, never inferred from names or slugs.
const theme = resolvePublicTheme(route?.action?.presentationTheme);
const imageUrl = new URL(theme.shareImage.src, publicOrigin).href;
const robots =
  state === "action" || state === "home" ? "index,follow" : "noindex,follow";
---

<PublicLayout
  canonicalUrl={canonicalUrl}
  description={description}
  imageUrl={imageUrl}
  robots={robots}
  title={title}
  theme={theme}
  canOrder={Boolean(
    route?.submissionsAllowed &&
      route.action?.orderForm &&
      route.availability !== "archive",
  )}
  carrierName={route?.action?.carrierName}
  privacyHref={state === "action" ? "#datenschutz" : undefined}
>
  {
    state === "action" && route ? (
      <PublicAction
        orderResult={publicOrderResult}
        route={route}
        theme={theme}
      />
    ) : state === "inactive" ? (
      <PublicState
        eyebrow="Zwischen zwei Aktionen"
        message="Sobald der nächste Jahrgang veröffentlicht ist, führt diese Adresse automatisch dorthin. Abgeschlossene Aktionen bleiben unter ihrer dauerhaften Archiv-Adresse erhalten."
        state="inactive"
        title="Derzeit keine aktive Aktion"
      />
    ) : state === "not-found" ? (
      <PublicState
        actionHref="/"
        actionLabel="Zur Startseite"
        eyebrow="Adresse nicht gefunden"
        message="Bitte prüfen Sie den Aktionslink oder verwenden Sie die Adresse, die Ihr Lions Club veröffentlicht hat."
        state="not-found"
        title="Diese Aktionsseite gibt es nicht."
      />
    ) : state === "unavailable" ? (
      <PublicState
        actionHref={Astro.url.pathname}
        actionLabel="Erneut versuchen"
        eyebrow="Kurze Unterbrechung"
        message="Die Aktionsdaten sind gerade nicht erreichbar. Es wurden keine Eingaben gespeichert oder verloren."
        state="unavailable"
        title="Bitte versuchen Sie es gleich noch einmal."
      />
    ) : (
      <PublicState
        eyebrow="Lions helfen vor Ort"
        message={
          campaigns.length > 0
            ? "Wählen Sie eine laufende Charity-Aktion Ihres Lions Clubs."
            : "Über die Aktionsadresse Ihres Lions Clubs gelangen Sie direkt zur aktuell veröffentlichten Charity-Aktion."
        }
        state="home"
        title="Engagement, das ankommt."
      />
    )
  }
  {
    state === "home" && campaigns.length > 0 && (
      <PublicCampaignList campaigns={campaigns} />
    )
  }
  {state === "home" && moduleEnabled("inbox") && <PublicInbox />}
</PublicLayout>
