---
import LegalImprint from "../components/LegalImprint.astro";
import PublicState from "../components/PublicState.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { IMPRINT_PATH, readLegalNotice } from "../lib/legal-notice";
import { requestOrigin } from "../lib/request-origin";
import { resolvePublicTheme } from "../themes";

// One Impressum per installation (one club, multi-domain decision D4),
// rendered from the provider of the active legal configuration. Only stored
// data is shown.
const notice = await readLegalNotice();
const provider = notice.state === "ready" ? notice.provider : null;
if (notice.state === "unavailable") Astro.response.status = 503;
Astro.response.headers.set(
  "Cache-Control",
  provider ? "public, max-age=60" : "no-store",
);
const origin = requestOrigin(Astro.request, Astro.url);
const theme = resolvePublicTheme(null);
---

<PublicLayout
  canonicalUrl={new URL(IMPRINT_PATH, origin).href}
  description="Impressum: Anbieter dieser Aktionsseiten"
  imageUrl={new URL(theme.shareImage.src, origin).href}
  robots={provider ? "index,follow" : "noindex,follow"}
  title="Impressum | LeonAid"
  theme={theme}
  legalNotice={notice}
>
  {
    provider ? (
      <section class="legal-page" aria-labelledby="imprint-heading">
        <LegalImprint provider={provider} />
      </section>
    ) : (
      <PublicState
        actionHref={notice.state === "unavailable" ? IMPRINT_PATH : "/"}
        actionLabel={
          notice.state === "unavailable" ? "Erneut versuchen" : "Zur Startseite"
        }
        eyebrow="Impressum"
        message={
          notice.state === "unavailable"
            ? "Die Angaben sind gerade nicht erreichbar. Bitte laden Sie die Seite in Kürze erneut."
            : "Der Club hinterlegt die Anbieterangaben gerade. Bitte schauen Sie später wieder vorbei."
        }
        state={notice.state === "unavailable" ? "unavailable" : "inactive"}
        title={
          notice.state === "unavailable"
            ? "Bitte versuchen Sie es gleich noch einmal."
            : "Das Impressum wird gerade eingerichtet."
        }
      />
    )
  }
</PublicLayout>
