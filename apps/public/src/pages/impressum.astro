---
import PublicState from "../components/PublicState.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { providerAddress, readLegalNotice } from "../lib/legal-notice";
import { resolvePublicTheme } from "../themes";

// One Impressum per installation (one club), rendered from the provider of
// the active legal configuration. Only stored data is shown.
const notice = await readLegalNotice();
const provider = notice.state === "ready" ? notice.provider : null;
if (notice.state === "unavailable") Astro.response.status = 503;
Astro.response.headers.set(
  "Cache-Control",
  provider ? "public, max-age=60" : "no-store",
);
const forwardedProtocol = Astro.request.headers
  .get("x-forwarded-proto")
  ?.split(",", 1)[0]
  ?.trim();
const origin = new URL(Astro.url.origin);
if (forwardedProtocol === "http" || forwardedProtocol === "https") {
  origin.protocol = `${forwardedProtocol}:`;
}
const theme = resolvePublicTheme(null);
---

<PublicLayout
  canonicalUrl={new URL("/impressum", origin).href}
  description="Impressum: Anbieter dieser Aktionsseiten"
  imageUrl={new URL(theme.shareImage.src, origin).href}
  robots={provider ? "index,follow" : "noindex,follow"}
  title="Impressum | LeonAid"
  theme={theme}
>
  {
    provider ? (
      <section class="legal-page" aria-labelledby="imprint-heading">
        <div class="site-shell legal-page__body">
          <h1 id="imprint-heading">Impressum</h1>
          <p class="legal-page__lead">Anbieter dieser Aktionsseiten</p>
          <dl class="legal-page__facts" data-imprint>
            <div>
              <dt>Name</dt>
              <dd data-imprint-name>{provider.legalName}</dd>
            </div>
            <div>
              <dt>Anschrift</dt>
              <dd data-imprint-address>{providerAddress(provider)}</dd>
            </div>
            <div>
              <dt>E-Mail</dt>
              <dd>
                <a href={`mailto:${provider.email}`}>{provider.email}</a>
              </dd>
            </div>
          </dl>
        </div>
      </section>
    ) : (
      <PublicState
        actionHref={notice.state === "unavailable" ? "/impressum" : "/"}
        actionLabel={
          notice.state === "unavailable" ? "Erneut versuchen" : "Zur Startseite"
        }
        eyebrow="Impressum"
        message={
          notice.state === "unavailable"
            ? "Die Angaben sind gerade nicht erreichbar. Bitte laden Sie die Seite in Kürze erneut."
            : "Der Club hinterlegt die Anbieterangaben gerade. Bitte schauen Sie später wieder vorbei."
        }
        state={notice.state === "unavailable" ? "unavailable" : "inactive"}
        title={
          notice.state === "unavailable"
            ? "Bitte versuchen Sie es gleich noch einmal."
            : "Das Impressum wird gerade eingerichtet."
        }
      />
    )
  }
</PublicLayout>
