---
import type {
  PublicActionRouteResponse,
  PublicCampaignRouteResponse,
  PublicOrderResultResponse,
} from "@leonaid/api-client";

import PublicInbox from "./PublicInbox.astro";
import PublicOrder from "./PublicOrder.astro";
import { moduleEnabled } from "../lib/modules";
import { offeringPrice, offeringUnit } from "../lib/order-presentation";
import type { PublicTheme } from "../themes";

interface OrderActionResult {
  data?: PublicOrderResultResponse;
  error?: { message: string };
}

interface Props {
  orderResult?: OrderActionResult;
  route: PublicActionRouteResponse | PublicCampaignRouteResponse;
  /** Resolved by the page from data; the generic hero is used without one. */
  theme?: PublicTheme;
}

const { orderResult, route, theme } = Astro.props;
const action = route.action;
// Theme intros render Core-owned routes; CMS campaigns pass their own intro.
const ThemeIntro =
  route.routeKind === "alias" || route.routeKind === "archive"
    ? theme?.Intro
    : undefined;
const orderAlias = "orderAlias" in route ? route.orderAlias : route.routeValue;

if (!action) {
  throw new Error("A published action page requires action data.");
}

const isArchive = route.availability === "archive";
// Contact requests belong to a live action; the archive stays read-only.
const inboxForm = route.availability === "published" && moduleEnabled("inbox");
const orderForm =
  route.submissionsAllowed && !isArchive && orderAlias
    ? action.orderForm
    : null;
const dateFormatter = new Intl.DateTimeFormat("de-DE", {
  day: "2-digit",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const numberFormatter = new Intl.NumberFormat("de-DE", {
  maximumFractionDigits: 2,
});

function publicDate(value: string): string {
  return dateFormatter.format(new Date(`${value}T00:00:00Z`));
}

const goalValue = action.goal.goalValue ? Number(action.goal.goalValue) : null;
const actualValue = Number(action.goal.actualValue);
const progress =
  goalValue !== null &&
  Number.isFinite(goalValue) &&
  goalValue > 0 &&
  Number.isFinite(actualValue)
    ? Math.min(100, Math.max(0, (actualValue / goalValue) * 100))
    : null;
const goalUnit = action.goal.unit ?? action.goal.currency ?? "";
---

<article
  class:list={["action-page", { "action-page--archive": isArchive }]}
  data-public-state={route.availability}
>
  {
    Astro.slots.has("intro") ? (
      <slot name="intro" />
    ) : ThemeIntro ? (
      <ThemeIntro route={route} />
    ) : (
      <section class="action-hero">
        <div class="site-shell action-hero__grid">
          <div class="action-hero__copy">
            <p class="eyebrow">
              {isArchive ? "Dauerhaftes Archiv" : "Jetzt aktiv"}
              <span aria-hidden="true">·</span>
              {action.carrierName}
            </p>
            <h1 data-testid="public-action-name">{action.name}</h1>
            <p class="action-hero__lead">{action.purpose}</p>
            <div class="action-hero__actions">
              <a
                class="primary-link"
                href={orderForm ? "#bestellen" : "#angebote"}
              >
                {isArchive
                  ? "Angebote der Aktion"
                  : orderForm
                    ? "Jetzt bestellen"
                    : "Angebote ansehen"}
                <span aria-hidden="true">↓</span>
              </a>
              <a class="text-link" href="#wirkung">
                Wem die Aktion hilft
              </a>
            </div>
            <dl class="action-facts" aria-label="Aktionsdaten">
              <div>
                <dt>Zeitraum</dt>
                <dd>
                  <time datetime={action.startsOn}>
                    {publicDate(action.startsOn)}
                  </time>
                  <span aria-hidden="true">–</span>
                  <time datetime={action.endsOn}>
                    {publicDate(action.endsOn)}
                  </time>
                </dd>
              </div>
              <div>
                <dt>Dauerhafte Adresse</dt>
                <dd data-testid="public-canonical-path">
                  {route.canonicalPath}
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </section>
    )
  }

  <slot name="after-intro" />

  {
    isArchive && (
      <aside class="archive-notice" aria-labelledby="archive-heading">
        <div class="site-shell archive-notice__inner">
          <span class="archive-notice__index" aria-hidden="true">
            Archiv
          </span>
          <div>
            <h2 id="archive-heading">Diese Aktion ist abgeschlossen.</h2>
            <p>
              Ergebnisse und Angebote bleiben nachvollziehbar. Neue Bestellungen
              oder Zusagen sind über diese Adresse nicht mehr möglich.
            </p>
          </div>
        </div>
      </aside>
    )
  }

  <section
    class="offerings-section"
    id="angebote"
    aria-labelledby="offerings-heading"
  >
    <div class="site-shell offerings-section__grid">
      <div class="section-intro">
        <p class="eyebrow">So können Sie unterstützen</p>
        <h2 id="offerings-heading">
          Ein Angebot, das vor Ort Wirkung entfaltet.
        </h2>
        <p>
          Preise und Einheiten stammen direkt aus der veröffentlichten Aktion.
          {
            isArchive
              ? " Die Darstellung dient der dauerhaften Dokumentation."
              : orderForm
                ? " Sie wählen die Menge und sehen den Gesamtbetrag sofort."
                : " Aktuell ist für diese Aktion kein Bestellformular freigeschaltet."
          }
        </p>
      </div>
      <div class="offering-list" data-testid="public-offerings">
        {
          action.offerings.length > 0 ? (
            action.offerings.map((offering, index) => (
              <article class="offering-row">
                <span class="offering-row__index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div class="offering-row__body">
                  <h3>{offering.name}</h3>
                  <p>
                    {offering.piecesPerUnit
                      ? `${offering.piecesPerUnit} Stück pro Einheit`
                      : "Direkte Unterstützung"}
                  </p>
                </div>
                <p class="offering-row__price">
                  <strong>{offeringPrice(offering)}</strong>
                  <span>{offeringUnit(offering)}</span>
                </p>
              </article>
            ))
          ) : (
            <p class="offering-empty">
              Für diese Aktion sind noch keine öffentlichen Angebote hinterlegt.
            </p>
          )
        }
      </div>
    </div>
  </section>

  {
    orderForm && orderAlias && (
      <PublicOrder
        action={action}
        orderForm={orderForm}
        publicAlias={orderAlias}
        contactFormHref={inboxForm ? "#kontakt" : undefined}
        orderResult={orderResult}
      />
    )
  }
  <section class="impact-section" id="wirkung" aria-labelledby="impact-heading">
    <div class="site-shell impact-section__grid">
      <div class="impact-section__title">
        <p class="eyebrow">Gemeinsame Wirkung</p>
        <h2 id="impact-heading">Wem die Aktion hilft</h2>
      </div>
      <ol class="beneficiary-list">
        {
          action.beneficiaries.map((beneficiary, index) => (
            <li>
              <span aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <h3>{beneficiary.organizationName}</h3>
                <p>{beneficiary.publicDescription}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    progress !== null && goalValue !== null && (
      <section class="goal-section" aria-labelledby="goal-heading">
        <div class="site-shell goal-section__grid">
          <div>
            <p class="eyebrow">Unser gemeinsames Ziel</p>
            <h2 id="goal-heading">
              {numberFormatter.format(actualValue)}
              <span>
                {" "}
                von {numberFormatter.format(goalValue)} {goalUnit}
              </span>
            </h2>
          </div>
          <div class="goal-meter">
            <div
              class="goal-meter__track"
              role="progressbar"
              aria-label={`Aktionsfortschritt: ${Math.round(progress)} Prozent`}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow={Math.round(progress)}
            >
              {/* An SVG width attribute instead of an inline style keeps the
                  page free of style attributes for the Content-Security-Policy. */}
              <svg
                viewBox="0 0 100 1"
                preserveAspectRatio="none"
                aria-hidden="true"
                focusable="false"
              >
                <rect width={progress.toFixed(2)} height="1" />
              </svg>
            </div>
            <p>{Math.round(progress)} % des Aktionsziels sind erreicht.</p>
          </div>
        </div>
      </section>
    )
  }

  {inboxForm && <PublicInbox actionId={action.id} actionName={action.name} />}

  <section
    class="privacy-section"
    id="datenschutz"
    aria-labelledby="privacy-heading"
  >
    <div class="site-shell privacy-section__grid">
      <p class="privacy-section__label">Datenschutz</p>
      <div>
        <h2 id="privacy-heading">Transparent, bevor Daten erhoben werden.</h2>
        {
          orderForm ? (
            <>
              <p>{orderForm.privacyNoticeText}</p>
              <dl class="privacy-section__facts">
                <div>
                  <dt>Rechtsgrundlage</dt>
                  <dd>{orderForm.legalBasis}</dd>
                </div>
                <div>
                  <dt>Verantwortlicher Kontakt</dt>
                  <dd>
                    <a href={`mailto:${orderForm.privacyContactEmail}`}>
                      {orderForm.privacyContactEmail}
                    </a>
                  </dd>
                </div>
                <div>
                  <dt>Textversion</dt>
                  <dd>{orderForm.privacyNoticeVersion}</dd>
                </div>
              </dl>
            </>
          ) : (
            <p>
              Für die Darstellung dieser Aktionsseite sind keine Anmeldung und
              keine Marketing-Cookies erforderlich. Ein Bestellformular wird
              erst nach Freigabe der Datenschutzgrundlage angeboten.
            </p>
          )
        }
      </div>
    </div>
  </section>
</article>
