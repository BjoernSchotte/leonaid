---
import type { DeliveryConfigurationResponse } from "@leonaid/api-client";

interface Props {
  configuration: DeliveryConfigurationResponse;
  selectedId?: string;
}
const { configuration, selectedId } = Astro.props;
const windows = configuration.windows.filter((window) => !window.retired);
const days = [...new Set(windows.map((window) => window.deliveryOn))].sort();
const dayLabel = (day: string) =>
  new Intl.DateTimeFormat("de-DE", {
    dateStyle: "full",
    timeZone: "UTC",
  }).format(new Date(`${day}T12:00:00Z`));
---

<fieldset class="delivery-windows" data-delivery-window-selection>
  <legend>Lieferfenster</legend>
  <p>
    Wir liefern innerhalb des gewählten Zeitraums. Alle Uhrzeiten gelten in
    {configuration.timezone}.
  </p>
  {
    days.map((day) => (
      <div class="delivery-day">
        <h3>{dayLabel(day)}</h3>
        <div class="delivery-options">
          {windows
            .filter((window) => window.deliveryOn === day)
            .sort((a, b) => a.startsAt.localeCompare(b.startsAt))
            .map((window) => (
              <label
                class="public-toggle-option"
                data-fully-booked={window.fullyBooked ? "" : undefined}
              >
                <input
                  id={`deliveryWindow-${window.id}`}
                  type="radio"
                  name="deliveryWindowId"
                  value={window.id}
                  checked={selectedId === window.id && !window.fullyBooked}
                  disabled={window.fullyBooked}
                  required
                  data-label="Lieferfenster"
                  aria-describedby="deliveryWindowId-error"
                />
                <span>
                  {window.startsAt.slice(0, 5)}–{window.endsAt.slice(0, 5)} Uhr
                  <span class="sr-only"> am {dayLabel(day)}</span>
                  {window.fullyBooked && (
                    <span class="delivery-full">ausgebucht</span>
                  )}
                </span>
              </label>
            ))}
        </div>
      </div>
    ))
  }
  {
    windows.length > 0 && windows.every((window) => window.fullyBooked) && (
      <p role="status">
        Alle Lieferfenster sind ausgebucht. Sobald der Club wieder Termine
        freigibt, können Sie hier bestellen.
      </p>
    )
  }
  {
    !windows.length && (
      <p role="status">
        Zurzeit ist kein Lieferfenster verfügbar. Sobald der Club neue Termine
        freigibt, können Sie hier bestellen.
      </p>
    )
  }
  <p
    id="deliveryWindowId-error"
    class="field-error"
    data-error-for="deliveryWindowId"
  >
  </p>
</fieldset>
