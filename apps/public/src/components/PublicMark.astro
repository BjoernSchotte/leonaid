---
interface Props {
  label?: string;
  /** Text next to the mark; the label still names the whole brand. */
  name?: string;
}

const { label = "LeonAid", name = "LeonAid" } = Astro.props;
---

<span class="public-brand" aria-label={label}>
  {/* The Lions "L" on Lions blue, as in the prototype's public header. */}
  <svg
    class="public-brand__mark"
    viewBox="0 0 28 28"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="28" height="28" rx="7"></rect>
    <path d="M9 6h4v12h8v4H9z"></path>
  </svg>
  <span>{name}</span>
</span>
