<script>
  import { actions, isInputError } from "astro:actions";
  import { orderQuantitySummary } from "../lib/order-presentation";

  const euro = (minor: number, currency: string) =>
    new Intl.NumberFormat("de-DE", { style: "currency", currency }).format(
      minor / 100,
    );

  const orderForms =
    document.querySelectorAll<HTMLFormElement>("[data-order-form]");

  for (const form of orderForms) {
    const billingSame = form.querySelector<HTMLInputElement>(
      "[data-billing-same]",
    );
    const billingFields = form.querySelector<HTMLElement>(
      "[data-billing-fields]",
    );
    const billingInputs = billingFields?.querySelectorAll<HTMLInputElement>(
      "input:not([type='hidden'])",
    );
    const quantityInputs =
      form.querySelectorAll<HTMLInputElement>("[data-quantity]");
    const previewTotal = form.querySelector<HTMLElement>(
      "[data-order-preview-total]",
    );
    const previewQuantity = form.querySelector<HTMLElement>(
      "[data-order-preview-quantity]",
    );
    const summaryTotal = form.querySelector<HTMLElement>(
      "[data-order-summary-total]",
    );
    const summaryQuantity = form.querySelector<HTMLElement>(
      "[data-order-summary-quantity]",
    );
    const submitButton = form.querySelector<HTMLButtonElement>(
      "[data-order-submit]",
    );
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const idleSubmitLabel =
      form.dataset.submitLabel ?? submitLabel?.textContent ?? "";
    const message = form.querySelector<HTMLElement>("[data-form-message]");
    const messageTitle = message?.querySelector<HTMLElement>(
      "[data-form-message-title]",
    );
    const messageText = message?.querySelector<HTMLElement>(
      "[data-form-message-text]",
    );
    const messageList = message?.querySelector<HTMLElement>(
      "[data-form-message-list]",
    );
    const success = form.parentElement?.querySelector<HTMLElement>(
      "[data-order-success]",
    );
    form.noValidate = true;
    const refreshButton = form.querySelector<HTMLButtonElement>(
      "[data-delivery-refresh]",
    );
    const refreshStatus = form.querySelector<HTMLElement>(
      "[data-delivery-refresh-status]",
    );
    // One request per submission, however often the button is pressed.
    let submitting = false;
    const deliveryUnavailable = () =>
      Boolean(form.querySelector("[data-delivery-window-selection]")) &&
      !form.querySelector('input[name="deliveryWindowId"]');
    const refreshDeliveryWindows = async () => {
      if (!refreshButton) return;
      refreshButton.disabled = true;
      if (refreshStatus)
        refreshStatus.textContent = "Lieferfenster werden aktualisiert …";
      try {
        // The current renderer rechecks publication and alias binding. Only its
        // window fieldset is refreshed; customer inputs and command stay intact.
        const url = new URL(location.href);
        url.searchParams.delete("_action");
        url.hash = "";
        const response = await fetch(url, {
          cache: "no-store",
          signal: AbortSignal.timeout(10_000),
        });
        if (!response.ok) throw new Error("Page unavailable");
        const document = new DOMParser().parseFromString(
          await response.text(),
          "text/html",
        );
        const freshForm =
          document.querySelector<HTMLFormElement>("[data-order-form]");
        const alias = (target: HTMLFormElement | null) =>
          target?.querySelector<HTMLInputElement>('[name="publicAlias"]')
            ?.value;
        const replacement = freshForm?.querySelector<HTMLElement>(
          "[data-delivery-window-selection]",
        );
        const current = form.querySelector<HTMLElement>(
          "[data-delivery-window-selection]",
        );
        if (
          !freshForm ||
          freshForm.dataset.actionId !== form.dataset.actionId ||
          alias(freshForm) !== alias(form) ||
          !replacement ||
          !current
        )
          throw new Error("Campaign changed");
        const selected =
          current.querySelector<HTMLInputElement>("input:checked")?.value;
        for (const input of replacement.querySelectorAll<HTMLInputElement>(
          'input[name="deliveryWindowId"]',
        ))
          input.checked = input.value === selected;
        current.replaceWith(replacement);
        if (refreshStatus)
          refreshStatus.textContent =
            selected && !replacement.querySelector("input:checked")
              ? "Das gewählte Lieferfenster ist nicht mehr verfügbar. Bitte wählen Sie ein anderes. Ihre übrigen Eingaben bleiben erhalten."
              : "Die Lieferfenster sind aktuell.";
      } catch {
        if (refreshStatus)
          refreshStatus.textContent =
            "Die Lieferfenster konnten nicht aktualisiert werden. Ihre Eingaben bleiben erhalten. Bitte versuchen Sie es erneut.";
      } finally {
        refreshButton.disabled = false;
        if (submitButton)
          submitButton.disabled = submitting || deliveryUnavailable();
      }
    };
    if (refreshButton) {
      refreshButton.hidden = false;
      refreshButton.addEventListener("click", refreshDeliveryWindows);
    }

    const syncBillingFields = () => {
      if (!billingSame || !billingFields || !billingInputs) return;
      const separateBilling = !billingSame.checked;
      billingFields.hidden = !separateBilling;
      for (const input of billingInputs) {
        input.required = separateBilling;
        input.disabled = !separateBilling;
      }
    };

    // "Firma oder Verein / Privatperson": a private order sends no company.
    const customerKind = form.querySelector<HTMLElement>(
      "[data-customer-kind]",
    );
    const companyField = form.querySelector<HTMLElement>(
      "[data-company-field]",
    );
    const companyInput =
      companyField?.querySelector<HTMLInputElement>("input") ?? null;
    const syncCustomerKind = () => {
      if (!customerKind || !companyField || !companyInput) return;
      const person =
        customerKind.querySelector<HTMLInputElement>("input:checked")?.value ===
        "person";
      companyField.hidden = person;
      companyInput.disabled = person;
    };
    if (customerKind) {
      customerKind.hidden = false;
      customerKind.addEventListener("change", syncCustomerKind);
    }

    const syncOrderPreview = () => {
      let totalMinor = 0;
      const lines = [];
      let currency = "EUR";
      for (const input of quantityInputs) {
        const quantity = Number(input.value || "0");
        const unitPrice = Number.parseInt(input.dataset.unitPrice || "0", 10);
        const piecesPerUnit = input.dataset.piecesPerUnit
          ? Number(input.dataset.piecesPerUnit)
          : null;
        totalMinor += quantity * unitPrice;
        lines.push({ unit: input.dataset.unit ?? "", piecesPerUnit, quantity });
        currency = input.dataset.currency || currency;
      }
      const total = euro(totalMinor, currency);
      const summary = orderQuantitySummary(lines);
      if (previewTotal) previewTotal.textContent = total;
      if (summaryTotal) summaryTotal.textContent = total;
      if (previewQuantity) previewQuantity.textContent = summary;
      if (summaryQuantity) summaryQuantity.textContent = summary;
      for (const input of quantityInputs) {
        const value = Number(input.value || "0");
        for (const button of form.querySelectorAll<HTMLButtonElement>(
          `[data-step-for="${CSS.escape(input.id)}"]`,
        )) {
          const step = Number(button.dataset.step);
          button.disabled =
            step < 0
              ? value <= Number(input.min || "0")
              : value >= Number(input.max || "5000");
        }
      }
    };

    // Steppers (- / +) around each quantity; the number stays editable.
    for (const button of form.querySelectorAll<HTMLButtonElement>(
      "[data-step]",
    )) {
      const input = form.querySelector<HTMLInputElement>(
        `#${CSS.escape(button.dataset.stepFor ?? "")}`,
      );
      if (!input) continue;
      button.hidden = false;
      button.addEventListener("click", () => {
        const minimum = Number(input.min || "0");
        const maximum = Number(input.max || "5000");
        const next = Math.min(
          maximum,
          Math.max(
            minimum,
            Math.trunc(Number(input.value || "0")) +
              Number(button.dataset.step),
          ),
        );
        input.value = String(next);
        input.dispatchEvent(new Event("input", { bubbles: true }));
      });
    }

    const labelFor = (control: HTMLElement): string => {
      if (control.dataset.label) return control.dataset.label;
      const label = control.id
        ? form.querySelector<HTMLLabelElement>(
            `label[for="${CSS.escape(control.id)}"]`,
          )
        : null;
      return (
        label?.textContent
          ?.replace("(optional)", "")
          .replace(/\s+/g, " ")
          .trim() ??
        control.getAttribute("name") ??
        ""
      );
    };

    const clearErrors = () => {
      for (const input of form.querySelectorAll<HTMLElement>(
        "[aria-invalid]",
      )) {
        input.removeAttribute("aria-invalid");
      }
      for (const error of form.querySelectorAll<HTMLElement>(
        "[data-error-for]",
      )) {
        error.textContent = "";
      }
      if (message) {
        message.hidden = true;
        message.dataset.state = "idle";
        message.removeAttribute("role");
        if (messageText) messageText.textContent = "";
        if (messageList) messageList.replaceChildren();
        for (const paragraph of message.querySelectorAll(
          "p:not([data-form-message-text])",
        ))
          paragraph.remove();
      }
    };

    // The error summary lists every problem with a link to its field and
    // takes the focus (prototype: "Bitte prüfen Sie …").
    const showFailure = (
      text: string,
      fields?: Readonly<Record<string, readonly string[] | undefined>>,
    ) => {
      const items: { id: string; text: string }[] = [];
      if (fields) {
        for (const [name, errors] of Object.entries(fields)) {
          const controls = [
            ...form.querySelectorAll<HTMLElement>(
              `[name="${CSS.escape(name)}"]`,
            ),
          ].filter((control) => !(control as HTMLInputElement).disabled);
          for (const control of controls)
            control.setAttribute("aria-invalid", "true");
          const first = controls[0];
          const error = form.querySelector<HTMLElement>(
            `[data-error-for="${CSS.escape(name)}"]`,
          );
          const detail = errors?.join(" ") ?? "";
          if (error) error.textContent = detail;
          if (first?.id)
            items.push({ id: first.id, text: `${labelFor(first)}: ${detail}` });
        }
      }
      if (!message) return;
      message.dataset.state = "error";
      message.setAttribute("role", "alert");
      if (messageTitle)
        messageTitle.textContent = items.length
          ? `Bitte prüfen Sie ${items.length === 1 ? "eine Angabe" : `${items.length} Angaben`}`
          : "Die Bestellung wurde noch nicht gesendet";
      if (messageText) messageText.textContent = text;
      messageList?.replaceChildren(
        ...items.map((item) => {
          const entry = document.createElement("li");
          const link = document.createElement("a");
          link.href = `#${item.id}`;
          link.textContent = item.text;
          link.addEventListener("click", (event) => {
            event.preventDefault();
            document.getElementById(item.id)?.focus();
          });
          entry.append(link);
          return entry;
        }),
      );
      message.hidden = false;
      message.focus();
    };

    const validityMessage = (control: HTMLInputElement): string => {
      const validity = control.validity;
      if (control.type === "radio")
        return "Bitte wählen Sie ein Lieferfenster.";
      if (validity.valueMissing)
        return (
          control.dataset.missing ??
          (control.type === "checkbox"
            ? "Bitte bestätigen Sie diesen Punkt."
            : "Bitte ausfüllen.")
        );
      if (validity.typeMismatch && control.type === "email")
        return "Bitte geben Sie eine gültige E-Mail-Adresse an, z. B. name@firma.de.";
      if (validity.rangeUnderflow || validity.rangeOverflow)
        return `Bitte eine Zahl zwischen ${control.min || 0} und ${control.max} angeben.`;
      return "Bitte prüfen Sie diese Angabe.";
    };

    billingSame?.addEventListener("change", syncBillingFields);
    form.addEventListener("change", (event) => {
      if (
        event.target instanceof HTMLInputElement &&
        event.target.name === "deliveryWindowId" &&
        event.target.checked
      ) {
        if (refreshStatus) refreshStatus.textContent = "";
        if (
          message?.dataset.state === "error" &&
          messageText?.textContent?.includes("Lieferfenster")
        )
          clearErrors();
      }
    });
    for (const input of quantityInputs) {
      input.addEventListener("input", syncOrderPreview);
    }
    form.addEventListener("input", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement) || !target.getAttribute("name")) {
        return;
      }
      target.removeAttribute("aria-invalid");
      const error = form.querySelector<HTMLElement>(
        `[data-error-for="${CSS.escape(target.getAttribute("name") ?? "")}"]`,
      );
      if (error) error.textContent = "";
    });

    syncBillingFields();
    syncCustomerKind();
    syncOrderPreview();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submitting) return;
      clearErrors();
      if (!form.checkValidity()) {
        const fields: Record<string, readonly string[]> = {};
        for (const control of form.querySelectorAll<HTMLInputElement>(
          "input:invalid, textarea:invalid",
        )) {
          if (!control.name || fields[control.name]) continue;
          fields[control.name] = [validityMessage(control)];
        }
        showFailure(
          "Die Bestellung wurde noch nicht gesendet. Ihre Eingaben bleiben erhalten.",
          fields,
        );
        return;
      }
      submitting = true;
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.setAttribute("aria-busy", "true");
      }
      if (submitLabel) submitLabel.textContent = "Wird gesendet …";

      try {
        const result = await actions.createPublicOrder(new FormData(form));
        if (result.error) {
          if (refreshButton && !isInputError(result.error))
            await refreshDeliveryWindows();
          showFailure(
            isInputError(result.error)
              ? "Die Bestellung wurde noch nicht gesendet. Ihre Eingaben bleiben erhalten."
              : result.error.message,
            isInputError(result.error) ? result.error.fields : undefined,
          );
          return;
        }
        if (!success) return;
        const reference = success.querySelector<HTMLElement>(
          "[data-order-reference]",
        );
        const total = success.querySelector<HTMLElement>("[data-order-total]");
        const quantity = success.querySelector<HTMLElement>(
          "[data-order-quantity]",
        );
        if (reference) reference.textContent = result.data.publicReference;
        if (total)
          total.textContent = euro(
            result.data.totalMinor,
            result.data.currency,
          );
        if (quantity)
          quantity.textContent = orderQuantitySummary(result.data.quantities);
        form.hidden = true;
        success.hidden = false;
        success.focus();
        success.scrollIntoView({
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "auto"
            : "smooth",
          block: "start",
        });
      } catch {
        showFailure(
          "Die Bestellung konnte gerade nicht übermittelt werden. Ihre Eingaben bleiben erhalten. Bitte versuchen Sie es erneut.",
        );
      } finally {
        submitting = false;
        if (submitButton) {
          submitButton.disabled = deliveryUnavailable();
          submitButton.removeAttribute("aria-busy");
        }
        if (submitLabel) submitLabel.textContent = idleSubmitLabel;
      }
    });
  }
</script>
