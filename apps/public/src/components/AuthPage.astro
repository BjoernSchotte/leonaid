---
interface Props {
  fresh?: boolean;
}

const { fresh = false } = Astro.props;
// Members sign in here as well, so /login says "du"; the fresh sign-in is a
// back-office step-up and says "Sie".
const title = fresh ? "Anmeldung bestätigen" : "Bei LeonAid anmelden";
const introduction = fresh
  ? "Für Rechnungen, Rollen und andere Vorgänge, die sich nicht einfach zurücknehmen lassen, bestätigen Sie Ihre Anmeldung erneut."
  : "Wir schicken dir einen Code per E-Mail. Ein Passwort brauchst du dafür nicht.";
const requestLabel = fresh ? "Code per E-Mail senden" : "Login-Code anfordern";
const mail =
  "M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z m18 2-10 7L2 6";
const signIn =
  "M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4 M10 17l5-5-5-5 M15 12H3";
---

<div class="login-card" data-auth-fresh={String(fresh)}>
  {
    fresh && (
      <span class="stepup-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          <path d="m9 12 2 2 4-4" />
        </svg>
      </span>
    )
  }
  <h1>{title}</h1>
  <p class="login-lead" id="auth-intro">{introduction}</p>
  <form id="request-login-form">
    {
      !fresh && (
        <div class="login-field">
          <label for="login-email">Login-E-Mail</label>
          <small id="login-email-help">
            Die Adresse, mit der du zu LeonAid eingeladen wurdest.
          </small>
          <input
            id="login-email"
            aria-describedby="login-email-help"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </div>
      )
    }
    <button class="login-submit" data-testid="request-login" type="submit">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d={mail}></path></svg
      >
      {requestLabel}
    </button>
    <p class="login-note">
      {
        fresh
          ? "Nach der Bestätigung kommen Sie direkt zu Ihrem Vorgang zurück."
          : "Aus Sicherheitsgründen ist die Antwort immer gleich – auch wenn die Adresse nicht registriert ist."
      }
    </p>
  </form>
  <form id="complete-login-form" hidden>
    <button class="login-back" id="login-back" type="button">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
      >
      {fresh ? "Zurück" : "Andere E-Mail-Adresse"}
    </button>
    {
      !fresh && (
        <div class="login-field code-email">
          <label for="complete-email">Login-E-Mail</label>
          <input
            id="complete-email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </div>
      )
    }
    <div class="login-field code-field">
      <label for="login-code">Sechsstelliger Code</label>
      <small id="login-code-help">
        {
          fresh
            ? "Der Code aus der zuletzt versendeten LeonAid-E-Mail. Sie können ihn auch einfügen."
            : "Der Code aus der zuletzt versendeten LeonAid-E-Mail. Du kannst ihn auch einfügen."
        }
      </small>
      <input
        class="login-code"
        id="login-code"
        aria-describedby="login-code-help"
        name="code"
        inputmode="numeric"
        autocomplete="one-time-code"
        pattern="[0-9]{6}"
        maxlength="6"
        required
      />
    </div>
    <button class="login-submit" data-testid="complete-login" type="submit">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d={signIn}></path></svg
      >
      {fresh ? "Anmeldung bestätigen" : "Anmelden"}
    </button>
    <p class="login-alt code-field">
      <button class="login-link" id="resend-code" type="button" disabled>
        Neuen Code senden
      </button>
    </p>
  </form>
  <p id="auth-status" class="login-status" role="status" aria-live="polite"></p>
  {
    fresh ? (
      <p class="login-alt">
        <a id="auth-cancel" href="/admin/">
          Abbrechen und zurück
        </a>
      </p>
    ) : (
      <p class="login-note">
        Keine Einladung erhalten? Wende dich an die Aktionsleitung deines Clubs.
      </p>
    )
  }
</div>

<script>
  import { safeLocalReturnTo } from "../lib/return-to";
  import {
    ApiError,
    LeonAidApiClient,
    type CurrentIdentityResponse,
  } from "@leonaid/api-client";

  function requiredElement<T extends Element>(selector: string): T {
    const element = document.querySelector<T>(selector);
    if (!element) {
      throw new Error(`LeonAid login element missing: ${selector}`);
    }
    return element;
  }

  const page = requiredElement<HTMLElement>(".login-card");
  const requestForm = requiredElement<HTMLFormElement>("#request-login-form");
  const completeForm = requiredElement<HTMLFormElement>("#complete-login-form");
  const status = requiredElement<HTMLElement>("#auth-status");
  const introduction = requiredElement<HTMLElement>("#auth-intro");
  const back = requiredElement<HTMLButtonElement>("#login-back");
  const resend = requiredElement<HTMLButtonElement>("#resend-code");
  const api = new LeonAidApiClient(window.location.origin);
  const initialIntroduction = introduction.textContent ?? "";

  const fresh = page.dataset.authFresh === "true";
  const parameters = new URLSearchParams(window.location.search);
  const token = parameters.get("token");
  const hasExplicitReturnTo = parameters.has("returnTo");
  const requestedReturnTo =
    parameters.get("returnTo") ?? (fresh ? "/admin/" : "/app/");
  const returnTo = safeLocalReturnTo(
    requestedReturnTo,
    fresh ? "/admin/" : "/app/",
  );
  const cancel = document.querySelector<HTMLAnchorElement>("#auth-cancel");
  if (cancel) cancel.href = returnTo;

  function defaultDestination(identity: CurrentIdentityResponse): string {
    const actionRoles = new Set(
      identity.actionMemberships.map((membership) => membership.role),
    );
    if (identity.globalRoles.includes("system_admin")) {
      return "/admin/system";
    }
    if (actionRoles.has("charity_admin")) {
      return "/admin/";
    }
    if (
      identity.globalRoles.includes("finance_reader") ||
      identity.globalRoles.includes("finance_manager") ||
      actionRoles.has("finance_reader")
    ) {
      return "/admin/invoices";
    }
    if (actionRoles.has("acquirer")) {
      return "/app/";
    }
    return (
      identity.navigation.find((item) => item.surface === "web")?.href ??
      identity.navigation[0]?.href ??
      "/app/"
    );
  }

  async function destinationAfterLogin(): Promise<string> {
    if (fresh || hasExplicitReturnTo) return returnTo;
    try {
      return defaultDestination(await api.getCurrentIdentity());
    } catch {
      return returnTo;
    }
  }

  function formControl(
    form: HTMLFormElement,
    name: string,
  ): HTMLInputElement | null {
    const control = form.elements.namedItem(name);
    return control instanceof HTMLInputElement ? control : null;
  }

  // A new code may be requested after 30 s; the server limits the rate.
  const RESEND_SECONDS = 30;
  let resendTimer: ReturnType<typeof setInterval> | undefined;
  function startResendCooldown(): void {
    let remaining = RESEND_SECONDS;
    resend.disabled = true;
    resend.textContent = `Neuen Code anfordern in ${remaining} s`;
    clearInterval(resendTimer);
    resendTimer = setInterval(() => {
      remaining -= 1;
      if (remaining > 0) {
        resend.textContent = `Neuen Code anfordern in ${remaining} s`;
        return;
      }
      clearInterval(resendTimer);
      resend.disabled = false;
      resend.textContent = "Neuen Code senden";
    }, 1000);
  }

  function showCode(email: string | null): void {
    requestForm.hidden = true;
    completeForm.hidden = false;
    const completeEmail = formControl(completeForm, "email");
    if (!fresh && email && completeEmail) completeEmail.value = email;
    // The address is known: name it instead of asking again.
    const emailField = completeForm.querySelector<HTMLElement>(".code-email");
    if (emailField && email) emailField.hidden = true;
    if (email) {
      introduction.textContent = "Wir haben dir einen Code geschickt an ";
      const strong = document.createElement("strong");
      strong.textContent = email;
      introduction.append(strong, ".");
    } else if (fresh) {
      introduction.textContent =
        "Wir haben Ihnen einen Code an Ihre Login-E-Mail geschickt.";
    }
    startResendCooldown();
    formControl(completeForm, "code")?.focus();
  }

  formControl(completeForm, "code")?.addEventListener("input", (event) => {
    (event.target as HTMLInputElement).removeAttribute("aria-invalid");
  });

  back.addEventListener("click", () => {
    clearInterval(resendTimer);
    completeForm.hidden = true;
    requestForm.hidden = false;
    introduction.textContent = initialIntroduction;
    status.textContent = "";
    status.dataset.state = "";
    const button = requestForm.querySelector<HTMLButtonElement>("button");
    if (button) button.disabled = false;
    (formControl(requestForm, "email") ?? button)?.focus();
  });

  resend.addEventListener("click", async () => {
    resend.disabled = true;
    status.setAttribute("role", "status");
    status.dataset.state = "";
    try {
      if (fresh) await api.requestFreshLogin();
      else
        await api.requestLogin({
          email: formControl(completeForm, "email")?.value ?? "",
        });
      status.dataset.state = "success";
      status.textContent = fresh
        ? "Neuer Code gesendet. Der vorherige Code gilt nicht mehr."
        : "Neuer Code gesendet, wenn der Zugang berechtigt ist.";
      startResendCooldown();
    } catch (error) {
      status.setAttribute("role", "alert");
      status.dataset.state = "error";
      status.textContent = tooMany(error)
        ? rateLimited
        : fresh
          ? "Der Code konnte nicht gesendet werden. Bitte versuchen Sie es erneut."
          : "Der Code konnte nicht gesendet werden. Versuche es erneut.";
      resend.disabled = false;
    }
  });

  const rateLimited = fresh
    ? "Zu viele Versuche in kurzer Zeit. Bitte warten Sie zehn Minuten und fordern Sie dann einen neuen Code an."
    : "Zu viele Versuche in kurzer Zeit. Warte bitte zehn Minuten und fordere den Zugang dann erneut an.";
  function tooMany(error: unknown): boolean {
    return error instanceof ApiError && error.status === 429;
  }

  if (token) {
    requestForm.hidden = true;
    completeForm.hidden = false;
    document
      .querySelectorAll<HTMLElement>(".code-field, .code-email, #login-back")
      .forEach((field) => {
        field.hidden = true;
      });
    const code = formControl(completeForm, "code");
    const email = formControl(completeForm, "email");
    if (code) code.required = false;
    if (email) email.required = false;
    introduction.textContent = fresh
      ? "Der Link ist bereit. Bestätigen Sie die Anmeldung."
      : "Der Magic Link ist bereit. Bestätige die einmalige Anmeldung.";
    window.history.replaceState(
      {},
      "",
      `${window.location.pathname}?returnTo=${encodeURIComponent(returnTo)}`,
    );
  }

  requestForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = requestForm.querySelector<HTMLButtonElement>("button");
    if (!button) return;
    button.disabled = true;
    status.setAttribute("role", "status");
    status.dataset.state = "";
    status.textContent = "Sicherer Zugang wird vorbereitet …";
    const email = fresh
      ? null
      : (formControl(requestForm, "email")?.value ?? "");
    try {
      if (fresh) {
        await api.requestFreshLogin();
      } else {
        await api.requestLogin({ email: email ?? "" });
      }
      status.dataset.state = "success";
      status.textContent = fresh
        ? "Geben Sie den Code aus der E-Mail hier ein."
        : "Wenn der Zugang berechtigt ist, wurde eine E-Mail versendet. Gib den Code hier ein.";
      showCode(email);
    } catch (error) {
      status.setAttribute("role", "alert");
      status.dataset.state = "error";
      status.textContent = tooMany(error)
        ? rateLimited
        : fresh
          ? "Ihre Sitzung ist nicht mehr gültig. Bitte melden Sie sich vollständig neu an."
          : "Der Login konnte gerade nicht vorbereitet werden. Versuche es erneut.";
      button.disabled = false;
    }
  });

  completeForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = completeForm.querySelector<HTMLButtonElement>("button");
    if (!button) return;
    button.disabled = true;
    status.setAttribute("role", "status");
    status.dataset.state = "";
    status.textContent = "Anmeldung wird sicher bestätigt …";
    const body = token
      ? { magicToken: token }
      : fresh
        ? { code: formControl(completeForm, "code")?.value ?? "" }
        : {
            email: formControl(completeForm, "email")?.value ?? "",
            code: formControl(completeForm, "code")?.value ?? "",
          };
    try {
      if (fresh) {
        await api.completeFreshLogin(body);
      } else {
        await api.completeLogin(body);
      }
      status.dataset.state = "success";
      status.textContent = fresh
        ? "Bestätigt. Sie können fortfahren."
        : "Erfolgreich angemeldet.";
      window.location.replace(await destinationAfterLogin());
    } catch {
      status.setAttribute("role", "alert");
      status.dataset.state = "error";
      status.textContent = fresh
        ? "Link oder Code ist ungültig oder abgelaufen. Fordern Sie einen neuen Code an."
        : "Link oder Code ist ungültig oder abgelaufen. Fordere einen neuen Code an.";
      formControl(completeForm, "code")?.setAttribute("aria-invalid", "true");
      button.disabled = false;
    }
  });
</script>
