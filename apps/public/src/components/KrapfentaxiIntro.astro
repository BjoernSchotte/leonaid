---
import { Image } from "astro:assets";
import type { PublicActionRouteResponse } from "@leonaid/api-client";

import hero from "../assets/krapfentaxi/hero.webp";
import logo from "../assets/krapfentaxi/logo.png";
import roesner from "../assets/krapfentaxi/roesner.jpg";

interface Props {
  route: PublicActionRouteResponse;
}

const { route } = Astro.props;
const action = route.action!;
const isArchive = route.availability === "archive";
const canOrder = route.submissionsAllowed && !isArchive && action.orderForm;
const dates = new Intl.DateTimeFormat("de-DE", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const date = (value: string) => dates.format(new Date(`${value}T00:00:00Z`));
---

<section class="taxi-hero" aria-labelledby="taxi-title" id="start">
  <Image
    class="taxi-hero__image"
    src={hero}
    widths={[640, 1024, 1568]}
    sizes="100vw"
    alt=""
    loading="eager"
    fetchpriority="high"
    quality={80}
  />
  <div class="taxi-hero__shade" aria-hidden="true"></div>
  <div class="site-shell taxi-hero__content">
    <Image
      class="taxi-hero__logo"
      src={logo}
      width={320}
      alt="Lions Krapfentaxi"
      loading="eager"
    />
    <p class="taxi-hero__welcome">
      {isArchive ? "Gemeinsam Gutes bewirkt" : "Süße Freude. Guter Zweck."}
    </p>
    <h1 id="taxi-title" data-testid="public-action-name">{action.name}</h1>
    <p class="taxi-hero__tagline">
      Eine kleine Geste für dein Team. Eine große Hilfe vor Ort.
    </p>
    <a
      class="primary-link taxi-button"
      href={canOrder ? "#bestellen" : "#angebote"}
    >
      {
        isArchive
          ? "Angebote der Aktion"
          : canOrder
            ? "Jetzt bestellen"
            : "Angebote ansehen"
      }
      <span aria-hidden="true">↓</span>
    </a>
    {
      isArchive && (
        <p class="taxi-hero__archive">
          Abgeschlossene Aktion · keine neuen Bestellungen
        </p>
      )
    }
  </div>
</section>

<section
  class="taxi-story"
  id="das-krapfentaxi"
  aria-labelledby="taxi-story-title"
>
  <div class="site-shell taxi-story__grid">
    <div class="taxi-story__brand" aria-hidden="true">
      <Image src={logo} width={360} alt="" loading="lazy" />
    </div>
    <div class="taxi-story__copy">
      <p class="eyebrow">Das Lions Krapfentaxi</p>
      <h2 id="taxi-story-title">Freude teilen.<br />Gutes möglich machen.</h2>
      <p class="taxi-story__lead">{action.purpose}</p>
      <p>
        Für die Kolleginnen und Kollegen, Geschäftspartner oder einfach für
        Menschen, denen du eine Freude machen möchtest: Mit Krapfen wird aus
        einer kleinen Aufmerksamkeit gemeinsame Unterstützung.
      </p>
      <p>
        Die Lions bringen Menschen zusammen. Welche Einrichtungen diese Aktion
        unterstützt, erfährst du weiter unten.
      </p>
      <a class="text-link" href="#wirkung"
        >Wem die Aktion hilft <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
  <dl class="site-shell taxi-facts">
    <div>
      <dt>Aktionszeitraum</dt><dd>
        <time datetime={action.startsOn}>{date(action.startsOn)}</time> – <time
          datetime={action.endsOn}>{date(action.endsOn)}</time
        >
      </dd>
    </div>
    <div><dt>Gemeinsam engagiert</dt><dd>{action.carrierName}</dd></div>
    <div>
      <dt>Dieser Jahrgang</dt><dd data-testid="public-canonical-path">
        {route.canonicalPath}
      </dd>
    </div>
  </dl>
</section>

<section class="taxi-bakery" aria-labelledby="taxi-bakery-title">
  <div class="site-shell taxi-story__grid">
    <div class="taxi-story__copy">
      <p class="eyebrow">Aus der Region. Für die Region.</p>
      <h2 id="taxi-bakery-title">
        Unsere Krapfenbäckerei:<br />Rösner Backstube.
      </h2>
      <p>
        Handwerk aus Würzburg: In der Rösner Backstube entstehen mit Hiffenmark
        gefüllte Krapfen. Regional gebacken, gemeinsam genossen – so verbinden
        sich süße Freude und ein guter Zweck.
      </p>
      <a
        class="text-link"
        href="https://www.roesner-backstube.de/"
        target="_blank"
        rel="noopener noreferrer"
        >Zur Rösner Backstube <span aria-hidden="true">↗</span><span
          class="sr-only"
        >
          (neuer Tab)</span
        ></a
      >
    </div>
    <div class="taxi-bakery__logo">
      <Image src={roesner} width={640} alt="Rösner Backstube" loading="lazy" />
    </div>
  </div>
</section>
