---
// Leitsystem tokens and self-hosted Barlow/JetBrains Mono (CSS only).
import "@leonaid/ui/fonts.css";
import "@leonaid/ui/leitsystem.css";
import "../styles/global.css";
// Preloaded so first paint already uses Barlow: a late swap from the
// fallback face shifts the whole layout (CLS budget in public-audit).
import barlow400 from "@fontsource/barlow/files/barlow-latin-400-normal.woff2?url";
import barlow600 from "@fontsource/barlow/files/barlow-latin-600-normal.woff2?url";
import barlow700 from "@fontsource/barlow/files/barlow-latin-700-normal.woff2?url";
// Theme modules own their scoped stylesheets; importing the registry here
// keeps them after the global styles in the cascade.
import { defaultTheme, type PublicTheme } from "../themes";
import { Image } from "astro:assets";

import PublicAppLinks from "../components/PublicAppLinks.astro";
import PublicMark from "../components/PublicMark.astro";
import {
  IMPRINT_PATH,
  PRIVACY_PATH,
  providerAddress,
  readLegalNotice,
  type LegalNoticeResult,
} from "../lib/legal-notice";

interface Props {
  canonicalUrl: string;
  description: string;
  imageUrl: string;
  imageMetadata?: { width?: number; height?: number; alt?: string };
  robots?: string;
  title: string;
  theme?: PublicTheme;
  canOrder?: boolean;
  carrierName?: string;
  /** A legal notice the page read already (/impressum); read here otherwise. */
  legalNotice?: LegalNoticeResult;
  campaignBrand?: {
    name: string;
    logo: { src: string; alt: string; width?: number; height?: number } | null;
  };
}

const {
  canonicalUrl,
  description,
  imageUrl,
  imageMetadata,
  robots = "index,follow",
  title,
  theme = defaultTheme,
  canOrder = false,
  carrierName,
  legalNotice: pageLegalNotice,
  campaignBrand,
} = Astro.props;
const legalNotice = pageLegalNotice ?? (await readLegalNotice());
const provider = legalNotice.state === "ready" ? legalNotice.provider : null;
const shareImage = imageMetadata ?? theme.shareImage;
const header = theme.header;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#00338d" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      [barlow400, barlow600, barlow700].map((href) => (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href={href}
          crossorigin="anonymous"
        />
      ))
    }
    <meta property="og:locale" content="de_DE" />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content={campaignBrand?.name ?? theme.siteName}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {
      shareImage.width && (
        <meta property="og:image:width" content={String(shareImage.width)} />
      )
    }
    {
      shareImage.height && (
        <meta property="og:image:height" content={String(shareImage.height)} />
      )
    }
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
  </head>
  <body class:list={[theme.bodyClass]}>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="site-shell site-header__inner">
        <a
          class="site-header__home"
          href={header ? header.homeHref : "/"}
          aria-label={header ? header.homeLabel : "LeonAid Startseite"}
        >
          {
            header ? (
              <>
                <>
                  {campaignBrand ? (
                    campaignBrand.logo && <img {...campaignBrand.logo} />
                  ) : (
                    <Image src={header.logo} width={64} alt="" />
                  )}
                  <span>{campaignBrand?.name ?? theme.siteName}</span>
                </>
              </>
            ) : (
              <PublicMark
                label={carrierName ?? "LeonAid"}
                name={carrierName ?? "LeonAid"}
              />
            )
          }
        </a>
        {
          header ? (
            <nav class={header.navigationClass} aria-label="Aktionsnavigation">
              {header.navigation(canOrder).map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </nav>
          ) : canOrder ? (
            <a class="site-header__promise" href="#bestellen">
              Bestellen
            </a>
          ) : (
            <span class="site-header__promise">Lions helfen vor Ort</span>
          )
        }
        <PublicAppLinks />
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-shell site-footer__inner">
        <PublicMark label="LeonAid – Engagement transparent gemacht" />
        <p>
          {
            theme.campaignFooter ? (
              <>
                Gemeinsam für den guten Zweck.
                <br />
                {carrierName}
                <br />
                Diese Aktionsseite wird mit LeonAid bereitgestellt.
              </>
            ) : (
              <>
                Eine öffentliche Aktionsseite des durchführenden Lions Clubs.
                LeonAid macht Engagement nachvollziehbar.
              </>
            )
          }
        </p>
      </div>
      {
        /* Prototype .public-footer-inner: provider and address on the left,
          Impressum and Datenschutz on the right. */
      }
      <div class="site-shell site-footer__legal" data-footer-legal>
        {
          provider ? (
            <span data-footer-provider>
              {provider.legalName} · {providerAddress(provider)}
            </span>
          ) : (
            carrierName && !theme.campaignFooter && <span>{carrierName}</span>
          )
        }
        <nav class="site-footer__links" aria-label="Rechtliches">
          <a href={IMPRINT_PATH}>Impressum</a>
          <span aria-hidden="true">·</span>
          <a href={PRIVACY_PATH}>Datenschutz</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
