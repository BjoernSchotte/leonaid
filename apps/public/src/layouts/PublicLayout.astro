---
import "@fontsource-variable/instrument-sans/wght.css";
import "@fontsource-variable/newsreader/wght.css";
import "../styles/global.css";

import PublicMark from "../components/PublicMark.astro";

interface Props {
  canonicalUrl: string;
  description: string;
  imageUrl: string;
  robots?: string;
  title: string;
}

const {
  canonicalUrl,
  description,
  imageUrl,
  robots = "index,follow",
  title,
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#00338d" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LeonAid" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1729" />
    <meta property="og:image:height" content="910" />
    <meta
      property="og:image:alt"
      content="Abstrakte Wege verbinden eine lokale Gemeinschaft."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="site-shell site-header__inner">
        <a class="site-header__home" href="/" aria-label="LeonAid Startseite">
          <PublicMark />
        </a>
        <span class="site-header__promise">Lions helfen vor Ort</span>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-shell site-footer__inner">
        <PublicMark label="LeonAid – Engagement transparent gemacht" />
        <p>
          Eine öffentliche Aktionsseite des durchführenden Lions Clubs. LeonAid
          macht Engagement nachvollziehbar.
        </p>
      </div>
    </footer>
  </body>
</html>
