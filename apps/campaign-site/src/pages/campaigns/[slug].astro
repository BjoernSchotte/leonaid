---
import { actions } from "astro:actions";
import PublicLayout from "../../../../public/src/layouts/PublicLayout.astro";
import PublicInbox from "../../../../public/src/components/PublicInbox.astro";
import PublicOrder from "../../../../public/src/components/PublicOrder.astro";
import { moduleEnabled } from "../../../../public/src/lib/modules";
import PublicAction from "../../../../public/src/components/PublicAction.astro";
import { resolveCampaignTheme } from "../../themes";
import { withEmDashRuntime } from "emdash/middleware";
import PublicState from "../../../../public/src/components/PublicState.astro";
import {
  PublicCampaignError,
  readPublicCoreCampaign,
} from "../../public/core-campaign";
import { readPublishedCampaign } from "../../public/published-campaign.mjs";
import { editorialHtml } from "../../public/editorial-html.mjs";
import { publicMediaPath } from "../../public/published-media.mjs";
import type { CampaignPageFields } from "../../campaign-fields.generated";

let state: "published" | "inactive" | "missing" | "unavailable" = "missing";
let route = null;
let content: CampaignPageFields | null = null;
let body = "";
const orderResult = Astro.getActionResult(actions.createPublicOrder);
try {
  route = await readPublicCoreCampaign(Astro.params.slug ?? "");
  if (route.availability === "inactive") state = "inactive";
  else if (route.action) {
    const actionId = route.action.id;
    const published = await withEmDashRuntime((runtime) =>
      readPublishedCampaign(runtime.db, actionId),
    );
    if (published) {
      content = published.data as CampaignPageFields;
      body = editorialHtml(content);
      state = "published";
    }
  }
} catch (error) {
  console.warn(
    error instanceof PublicCampaignError
      ? "public_campaign_core_unavailable"
      : "public_campaign_content_unavailable",
  );
  content = null;
  route = null;
  state =
    error instanceof PublicCampaignError && error.status === 404
      ? "missing"
      : "unavailable";
}
Astro.response.status =
  state === "unavailable" ? 503 : state === "published" ? 200 : 404;
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-LeonAid-Campaign-State", state);
if (
  state === "published" &&
  route &&
  Astro.url.pathname !== route.canonicalPath
)
  return Astro.redirect(route.canonicalPath, 308);
const action = state === "published" ? route?.action : null;
// The editor's theme choice is data; the registry maps it to layout and intro.
const campaignTheme = resolveCampaignTheme(action ? content?.theme : null);
const ThemeIntro = campaignTheme.Intro;
const brandedHeader = Boolean(action && campaignTheme.publicTheme.header);
const orderForm =
  action && route?.submissionsAllowed && route.orderAlias
    ? action.orderForm
    : null;
const title =
  content && action ? `${content.title} · LeonAid` : "Aktionsseite · LeonAid";
const origin = new URL(process.env.EMDASH_SITE_URL!);
const socialImage = content?.social_image ?? content?.hero_image;
const canonicalUrl = new URL(route?.canonicalPath ?? Astro.url.pathname, origin)
  .href;
const money = (amount: number, currency: string) =>
  new Intl.NumberFormat("de-DE", { style: "currency", currency }).format(
    amount / 100,
  );
const units = {
  box: "je Box",
  package: "je Paket",
  piece: "je Stück",
  sponsoring: "je Sponsoring",
};
// The contact form renders below the order on published pages with the inbox
// module; the order confirmation then links to it instead of the mailto.
const showsInbox = Boolean(
  action && route?.availability === "published" && moduleEnabled("inbox"),
);
---

<PublicLayout
  title={title}
  description={content?.seo_description ??
    content?.hero_summary ??
    action?.purpose ??
    "Gemeinsam helfen vor Ort."}
  canonicalUrl={canonicalUrl}
  imageUrl={new URL(
    socialImage && action
      ? publicMediaPath(action.archiveSlug, socialImage.id)
      : "/community-routes.png",
    origin,
  ).href}
  imageMetadata={socialImage
    ? {
        width: socialImage.width,
        height: socialImage.height,
        alt: socialImage.alt ?? "",
      }
    : undefined}
  robots={state === "published" ? "index,follow" : "noindex,follow"}
  canOrder={Boolean(orderForm)}
  carrierName={action?.carrierName}
  theme={campaignTheme.publicTheme}
  campaignBrand={brandedHeader && action
    ? {
        name: action.name,
        logo: content?.brand_logo
          ? {
              src: publicMediaPath(action.archiveSlug, content.brand_logo.id),
              alt: "",
              width: content.brand_logo.width,
              height: content.brand_logo.height,
            }
          : null,
      }
    : undefined}
>
  {
    content && action && route && ThemeIntro ? (
      <PublicAction route={route} orderResult={orderResult}>
        <ThemeIntro slot="intro" route={route} content={content} />
        {!!content.faq?.length && (
          <section
            slot="after-intro"
            class="site-shell campaign-faq"
            aria-labelledby="faq-heading"
          >
            <h2 id="faq-heading">Häufige Fragen</h2>
            {content.faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </section>
        )}
      </PublicAction>
    ) : content && action ? (
      <article class="campaign-story" data-campaign-state="published">
        {/* The prototype's Lions-blue hero (apps/public .action-hero). */}
        <header id="start" class="action-hero">
          <div class="site-shell action-hero__grid">
            <div class="action-hero__copy">
              <p class="eyebrow">{action.carrierName}</p>
              <h1>{content.hero_title || content.title}</h1>
              {content.hero_summary && (
                <p class="action-hero__lead">{content.hero_summary}</p>
              )}
              {orderForm && (
                <div class="action-hero__actions">
                  <a class="primary-link" href="#bestellen">
                    Zur Bestellung
                  </a>
                </div>
              )}
            </div>
          </div>
        </header>
        <div class="site-shell campaign-body">
          {content.hero_image && (
            <img
              class="campaign-hero-image"
              src={publicMediaPath(action.archiveSlug, content.hero_image.id)}
              alt={content.hero_image.alt ?? ""}
              width={content.hero_image.width}
              height={content.hero_image.height}
              fetchpriority="high"
            />
          )}
          <section
            aria-label="Über die Aktion"
            class="editorial"
            set:html={body}
          />
          <section id="wirkung" aria-labelledby="purpose-heading">
            <>
              <h2 id="purpose-heading">Wem wir helfen</h2>
              <p>{action.purpose}</p>
            </>
          </section>
          {action.offerings.length > 0 && (
            <section id="angebote" aria-labelledby="offerings-heading">
              <h2 id="offerings-heading">Unsere Angebote</h2>
              <ul class="offers">
                {action.offerings.map((offering) => (
                  <li>
                    <h3>{offering.name}</h3>
                    <p>
                      {money(offering.unitPriceMinor, offering.currency)} ·{" "}
                      {units[offering.unit]}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          )}
          {!!content.faq?.length && (
            <section aria-labelledby="faq-heading">
              <h2 id="faq-heading">Häufige Fragen</h2>
              {content.faq.map((item) => (
                <details>
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </section>
          )}
          {!!content.partners?.length && (
            <section aria-labelledby="partners-heading">
              <h2 id="partners-heading">Gemeinsam möglich gemacht</h2>
              <ul class="partners">
                {content.partners.map((partner) => (
                  <li>
                    {partner.logo && (
                      <img
                        class="campaign-partner-logo"
                        src={publicMediaPath(
                          action.archiveSlug,
                          partner.logo.id,
                        )}
                        alt={partner.logo.alt ?? ""}
                        width={partner.logo.width}
                        height={partner.logo.height}
                        loading="lazy"
                      />
                    )}
                    <h3>
                      {partner.website ? (
                        <a href={partner.website} rel="noopener noreferrer">
                          {partner.name}
                        </a>
                      ) : (
                        partner.name
                      )}
                    </h3>
                    {partner.description && <p>{partner.description}</p>}
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </article>
    ) : (
      <PublicState
        state={state === "unavailable" ? "unavailable" : "not-found"}
        eyebrow={
          state === "unavailable"
            ? "Kurze Unterbrechung"
            : "Noch nicht öffentlich"
        }
        title={
          state === "unavailable"
            ? "Bitte versuchen Sie es gleich noch einmal."
            : "Diese Aktionsseite ist derzeit nicht veröffentlicht."
        }
        message={
          state === "unavailable"
            ? "Die Aktionsseite ist gerade nicht erreichbar. Bitte laden Sie sie in Kürze erneut."
            : "Bitte verwenden Sie den aktuellen Aktionslink Ihres Lions Clubs oder schauen Sie später wieder vorbei."
        }
        actionHref={state === "unavailable" ? Astro.url.pathname : "/"}
        actionLabel={
          state === "unavailable" ? "Erneut versuchen" : "Zur Startseite"
        }
      />
    )
  }
  {
    !ThemeIntro && action && orderForm && route?.orderAlias && (
      <PublicOrder
        action={action}
        orderForm={orderForm}
        publicAlias={route.orderAlias}
        contactFormHref={showsInbox ? "#kontakt" : undefined}
        orderResult={orderResult}
      />
    )
  }
  {
    !ThemeIntro && action && showsInbox && (
      <PublicInbox actionId={action.id} actionName={action.name} />
    )
  }
</PublicLayout>
<style>
  /* Leitsystem type scale and Lions colours (tokens from @leonaid/ui via the
     public layout), following the prototype's public page sections. */
  .campaign-body {
    display: grid;
    gap: var(--s-10);
    padding-block: var(--s-10) var(--s-12);
  }
  .campaign-hero-image {
    width: 100%;
    max-width: 48rem;
    height: auto;
    border-radius: var(--r-lg);
  }
  .campaign-partner-logo {
    width: 8rem;
    height: 6rem;
    object-fit: contain;
    object-position: left center;
  }
  .campaign-body > section {
    display: grid;
    gap: var(--s-4);
  }
  .campaign-body h2 {
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
  }
  .campaign-body h3 {
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
  }
  .editorial,
  .campaign-body section > p {
    max-width: 64ch;
    color: var(--text-2);
    line-height: var(--lh-prose);
  }
  .editorial :global(p + p) {
    margin-top: var(--s-3);
  }
  .editorial :global(a) {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .offers,
  .partners {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--s-3) var(--s-6);
    padding: 0;
    list-style: none;
  }
  /* Offers as the prototype's offer card. */
  .offers li {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-4);
    border: var(--hair) solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
  }
  .offers li p {
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
  }
  .partners li {
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  .partners li p {
    max-width: 48ch;
    color: var(--text-2);
  }
  .campaign-faq {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-10);
  }
  .campaign-faq h2 {
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
  }
  details {
    border-top: var(--hair) solid var(--border);
  }
  details:last-of-type {
    border-bottom: var(--hair) solid var(--border);
  }
  summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-block: var(--s-2);
    font-weight: var(--fw-semibold);
    cursor: pointer;
  }
  details p {
    max-width: 64ch;
    padding-bottom: var(--s-3);
    color: var(--text-2);
    line-height: var(--lh-prose);
    white-space: pre-line;
  }
</style>
