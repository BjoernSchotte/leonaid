---
import type { PublicCampaignRouteResponse } from "@leonaid/api-client";
import type { CampaignPageFields } from "../campaign-fields.generated";
import { editorialHtml } from "../public/editorial-html.mjs";
import { publicMediaPath } from "../public/published-media.mjs";

interface Props {
  route: PublicCampaignRouteResponse;
  content: CampaignPageFields;
}
const { route, content } = Astro.props;
const action = route.action!;
const canOrder =
  route.submissionsAllowed && route.orderAlias && action.orderForm;
const source = (id: string) => publicMediaPath(action.archiveSlug, id);
const dates = new Intl.DateTimeFormat("de-DE", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const date = (value: string) => dates.format(new Date(`${value}T00:00:00Z`));
const logo = content.brand_logo;
---

<section class="taxi-hero" aria-labelledby="taxi-title" id="start">
  {
    content.hero_image && (
      <img
        class="taxi-hero__image"
        src={source(content.hero_image.id)}
        alt={content.hero_image.alt ?? ""}
        width={content.hero_image.width}
        height={content.hero_image.height}
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <div class="taxi-hero__shade" aria-hidden="true"></div>
  <div class="site-shell taxi-hero__content">
    {
      logo && (
        <img
          class="taxi-hero__logo"
          src={source(logo.id)}
          alt={logo.alt ?? ""}
          width={logo.width}
          height={logo.height}
          loading="eager"
        />
      )
    }
    <h1 id="taxi-title" data-testid="public-action-name">{action.name}</h1>
    {
      content.hero_title && (
        <p class="taxi-hero__welcome">{content.hero_title}</p>
      )
    }
    {
      content.hero_summary && (
        <p class="taxi-hero__tagline">{content.hero_summary}</p>
      )
    }
    <a
      class="primary-link taxi-button"
      href={canOrder ? "#bestellen" : "#angebote"}
    >
      {canOrder ? "Jetzt bestellen" : "Angebote ansehen"}<span
        aria-hidden="true">↓</span
      >
    </a>
  </div>
</section>
<section class="taxi-story" id="das-krapfentaxi" aria-label="Über die Aktion">
  <div
    class:list={[
      "site-shell taxi-story__grid",
      { "cms-story-without-logo": !logo },
    ]}
  >
    {
      logo && (
        <div class="taxi-story__brand" aria-hidden="true">
          <img
            src={source(logo.id)}
            alt=""
            width={logo.width}
            height={logo.height}
            loading="lazy"
          />
        </div>
      )
    }
    <div class="taxi-story__copy">
      {content.story_eyebrow && <p class="eyebrow">{content.story_eyebrow}</p>}
      {
        content.story_title && (
          <h2 class="cms-multiline">{content.story_title}</h2>
        )
      }
      <p class="taxi-story__lead">{action.purpose}</p>
      <div class="editorial" set:html={editorialHtml(content)} />
      <a class="text-link" href="#wirkung"
        >Wem die Aktion hilft <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
  <dl class="site-shell taxi-facts">
    <div>
      <dt>Aktionszeitraum</dt><dd>
        <time datetime={action.startsOn}>{date(action.startsOn)}</time> –
        <time datetime={action.endsOn}>{date(action.endsOn)}</time>
      </dd>
    </div>
    <div><dt>Gemeinsam engagiert</dt><dd>{action.carrierName}</dd></div>
    <div>
      <dt>Dieser Jahrgang</dt><dd data-testid="public-canonical-path">
        {route.canonicalPath}
      </dd>
    </div>
  </dl>
</section>
{
  content.partners?.map((partner) => (
    <section class="taxi-bakery" aria-label={partner.name}>
      <div
        class:list={[
          "site-shell taxi-story__grid",
          { "cms-story-without-logo": !partner.logo },
        ]}
      >
        <div class="taxi-story__copy">
          {partner.eyebrow && <p class="eyebrow">{partner.eyebrow}</p>}
          <h2 class="cms-multiline">{partner.name}</h2>
          {partner.description && <p>{partner.description}</p>}
          {partner.website && (
            <a
              class="text-link"
              href={partner.website}
              rel="noopener noreferrer"
            >
              {partner.link_label || partner.name}
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
        {partner.logo && (
          <div class="taxi-bakery__logo">
            <img
              src={source(partner.logo.id)}
              alt={partner.logo.alt ?? ""}
              width={partner.logo.width}
              height={partner.logo.height}
              loading="lazy"
            />
          </div>
        )}
      </div>
    </section>
  ))
}
<style>
  .cms-multiline {
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  .cms-story-without-logo {
    grid-template-columns: minmax(0, 1fr);
  }
  .editorial {
    overflow-wrap: anywhere;
  }
  .editorial :global(a) {
    text-decoration: underline;
  }
</style>
