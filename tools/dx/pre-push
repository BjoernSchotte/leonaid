#!/bin/sh
# leonaid-pre-push-hook: installed by ./leonaid install-pre-push-hook.
# Runs ./leonaid check-fast in the checkout being pushed (the hook is shared by
# all worktrees of the repository). Skip once with: git push --no-verify
root=$(git rev-parse --show-toplevel) || exit 1
if ! grep -q '^  check-fast)' "$root/leonaid" 2>/dev/null; then
  # A branch from before check-fast existed: nothing to run.
  exit 0
fi
# check-fast checks the working tree, not the pushed commits: say so when
# they can differ (uncommitted changes, or pushing another ref than HEAD).
head=$(git rev-parse HEAD 2>/dev/null)
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    "" | 0000000000000000000000000000000000000000) ;;
    "$head") ;;
    *) echo "pre-push: WARNING: pushing $local_ref, but check-fast checks the working tree at HEAD" >&2 ;;
  esac
done
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: WARNING: uncommitted changes are checked but not pushed" >&2
fi
# The CLI runs its own git commands against $root.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
echo "pre-push: ./leonaid check-fast (skip once with git push --no-verify)" >&2
exec "$root/leonaid" check-fast </dev/null
